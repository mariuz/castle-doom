procedure TAcsGlobals.Clear;
var
  I: Integer;
begin
  for I := 0 to High(WorldVars) do WorldVars[I] := 0;
  for I := 0 to High(GlobalVars) do GlobalVars[I] := 0;
  SetLength(ArrayKeys, 0);
  SetLength(ArrayValues, 0);
  SetLength(CVarNames, 0);
  SetLength(CVarValues, 0);
  SetLength(CVarTexts, 0);
end;

function TAcsGlobals.CVarIndex(const Name: String; const Add: Boolean): Integer;
begin
  for Result := 0 to High(CVarNames) do
    if SameText(CVarNames[Result], Name) then Exit;
  Result := -1;
  if not Add then Exit;
  Result := Length(CVarNames);
  SetLength(CVarNames, Result + 1);
  SetLength(CVarValues, Result + 1);
  SetLength(CVarTexts, Result + 1);
  CVarNames[Result] := LowerCase(Name);
  CVarValues[Result] := 0;
  CVarTexts[Result] := '';
end;

function FindKey(const Keys: array of Int64; const Key: Int64; out Pos: Integer): Boolean;
var
  Lo, Hi, Mid: Integer;
begin
  Lo := 0;
  Hi := High(Keys);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if Keys[Mid] = Key then
    begin
      Pos := Mid;
      Exit(true);
    end;
    if Keys[Mid] < Key then Lo := Mid + 1 else Hi := Mid - 1;
  end;
  Pos := Lo;
  Result := false;
end;

function TAcsGlobals.GetArray(const A, Index: Integer): Integer;
var
  P: Integer;
begin
  if FindKey(ArrayKeys, (Int64(A) shl 32) or Cardinal(Index), P) then
    Result := ArrayValues[P]
  else
    Result := 0;
end;

procedure TAcsGlobals.SetArray(const A, Index, Value: Integer);
var
  P, N, K: Integer;
  Key: Int64;
begin
  Key := (Int64(A) shl 32) or Cardinal(Index);
  if FindKey(ArrayKeys, Key, P) then
  begin
    ArrayValues[P] := Value;
    Exit;
  end;
  N := Length(ArrayKeys);
  SetLength(ArrayKeys, N + 1);
  SetLength(ArrayValues, N + 1);
  for K := N downto P + 1 do
  begin
    ArrayKeys[K] := ArrayKeys[K - 1];
    ArrayValues[K] := ArrayValues[K - 1];
  end;
  ArrayKeys[P] := Key;
  ArrayValues[P] := Value;
end;

function IntsToJson(const Values: array of Integer): TJSONArray;
var
  I, Last: Integer;
begin
  Result := TJSONArray.Create;
  { Trailing zeros are left out. }
  Last := High(Values);
  while (Last >= 0) and (Values[Last] = 0) do Dec(Last);
  for I := 0 to Last do Result.Add(Values[I]);
end;

procedure IntsFromJson(const Arr: TJSONData; var Values: array of Integer);
var
  I: Integer;
begin
  for I := 0 to High(Values) do Values[I] := 0;
  if not (Arr is TJSONArray) then Exit;
  for I := 0 to Min(High(Values), TJSONArray(Arr).Count - 1) do
    if TJSONArray(Arr).Items[I].JSONType = jtNumber then
      Values[I] := TJSONArray(Arr).Items[I].AsInteger;
end;

function TAcsGlobals.SaveState: TJSONObject;
var
  Arr: TJSONArray;
  I: Integer;
begin
  Result := TJSONObject.Create;
  Result.Add('world', IntsToJson(WorldVars));
  Result.Add('global', IntsToJson(GlobalVars));
  Arr := TJSONArray.Create;
  for I := 0 to High(ArrayKeys) do
  begin
    Arr.Add(Integer(ArrayKeys[I] shr 32));
    Arr.Add(Integer(Cardinal(ArrayKeys[I] and $FFFFFFFF)));
    Arr.Add(ArrayValues[I]);
  end;
  Result.Add('arrays', Arr);
  if Length(CVarNames) > 0 then
  begin
    Arr := TJSONArray.Create;
    for I := 0 to High(CVarNames) do
    begin
      Arr.Add(CVarNames[I]);
      Arr.Add(CVarValues[I]);
      Arr.Add(CVarTexts[I]);
    end;
    Result.Add('cvars', Arr);
  end;
end;

procedure TAcsGlobals.LoadState(const J: TJSONObject);
var
  Arr: TJSONData;
  I: Integer;
begin
  Clear;
  if J = nil then Exit;
  IntsFromJson(J.Find('world'), WorldVars);
  IntsFromJson(J.Find('global'), GlobalVars);
  Arr := J.Find('arrays');
  if Arr is TJSONArray then
    for I := 0 to TJSONArray(Arr).Count div 3 - 1 do
      SetArray(TJSONArray(Arr).Integers[I * 3], TJSONArray(Arr).Integers[I * 3 + 1],
        TJSONArray(Arr).Integers[I * 3 + 2]);
  Arr := J.Find('cvars');
  if Arr is TJSONArray then
    for I := 0 to TJSONArray(Arr).Count div 3 - 1 do
    begin
      CVarIndex(TJSONArray(Arr).Strings[I * 3], true);
      CVarValues[High(CVarValues)] := TJSONArray(Arr).Integers[I * 3 + 1];
      CVarTexts[High(CVarTexts)] := TJSONArray(Arr).Strings[I * 3 + 2];
    end;
end;

{ TAcsVM -------------------------------------------------------------------- }

destructor TAcsLoaded.Destroy;
begin
  FreeAndNil(Module);
  inherited;
end;

{ ZDoom tags a library's strings with its number in the high 16 bits. }
const
  AcsMaxModules = 15;

constructor TAcsVM.Create(const AModule: TAcsModule; const AHost: TAcsHost; const AGlobals: TAcsGlobals);
begin
  inherited Create;
  FHost := AHost;
  FGlobals := AGlobals;
  FMods := TObjectList.Create(true);
  FInstances := TObjectList.Create(true);
  FLogged := TStringList.Create;
  FLogged.Sorted := true;
  AddModule(AModule, '');
  Link;
end;

destructor TAcsVM.Destroy;
begin
  FreeAndNil(FInstances);
  FreeAndNil(FLogged);
  FreeAndNil(FMods);
  inherited;
end;

function TAcsVM.Mods(const Index: Integer): TAcsLoaded;
begin
  Result := TAcsLoaded(FMods[Index]);
end;

function TAcsVM.ModuleCount: Integer;
begin
  Result := FMods.Count;
end;

function TAcsVM.Module: TAcsModule;
begin
  Result := Mods(0).Module;
end;

function TAcsVM.AddModule(const AModule: TAcsModule; const AName: String): Integer;
var
  L: TAcsLoaded;
  I, J, K, Tag: Integer;
begin
  L := TAcsLoaded.Create;
  L.Module := AModule;
  L.Name := AName;
  Result := FMods.Add(L);
  Tag := Result shl 16;
  for I := 0 to AcsMapVarCount - 1 do
  begin
    L.MapVars[I] := AModule.MapVarInit[I];
    L.VarModule[I] := Result;
    L.VarIndex[I] := I;
  end;
  { A map array's variable holds the array's number. }
  SetLength(L.MapArrays, Length(AModule.ArrayVar));
  for I := 0 to High(AModule.ArrayVar) do
  begin
    SetLength(L.MapArrays[I], AModule.ArraySize[I]);
    for J := 0 to AModule.ArraySize[I] - 1 do
      if J <= High(AModule.ArrayInit[I]) then
        L.MapArrays[I][J] := AModule.ArrayInit[I][J]
      else
        L.MapArrays[I][J] := 0;
  end;
  { A library's strings in its variables and arrays carry its number. }
  if Result > 0 then
  begin
    for K in AModule.StringVars do
      if (K >= 0) and (K < AcsMapVarCount) then
        L.MapVars[K] := L.MapVars[K] or Tag;
    for I := 0 to High(AModule.ArrayVar) do
    begin
      for K in AModule.StringArrays do
        if K = AModule.ArrayVar[I] then
          for J := 0 to High(L.MapArrays[I]) do
            L.MapArrays[I][J] := L.MapArrays[I][J] or Tag;
      for K := 0 to High(AModule.ArrayTags) do
        if AModule.ArrayTags[K].Index = AModule.ArrayVar[I] then
          for J := 0 to Min(High(L.MapArrays[I]), High(AModule.ArrayTags[K].Tags)) do
            if AModule.ArrayTags[K].Tags[J] = 1 then
              L.MapArrays[I][J] := L.MapArrays[I][J] or Tag;
    end;
  end;
  for I := 0 to High(AModule.ArrayVar) do
    if (AModule.ArrayVar[I] >= 0) and (AModule.ArrayVar[I] < AcsMapVarCount) then
      L.MapVars[AModule.ArrayVar[I]] := I;
  SetLength(L.FuncModule, Length(AModule.Functions));
  SetLength(L.FuncIndex, Length(AModule.Functions));
  for I := 0 to High(AModule.Functions) do
  begin
    L.FuncModule[I] := Result;
    L.FuncIndex[I] := I;
  end;
  { The libraries this one loads. }
  for I := 0 to High(AModule.Libraries) do
    LoadLibrary(AModule.Libraries[I]);
end;

function TAcsVM.LoadLibrary(const Name: String): Integer;
var
  Data: TBytes;
  M: TAcsModule;
  I: Integer;
begin
  for I := 1 to FMods.Count - 1 do
    if SameText(Mods(I).Name, Name) then Exit(I);
  Result := -1;
  if FMods.Count > AcsMaxModules then
  begin
    WritelnLog('Acs', 'library %s not loaded: more than %d libraries', [Name, AcsMaxModules]);
    Exit;
  end;
  Data := FHost.LibraryData(Name);
  if Length(Data) = 0 then
  begin
    WritelnLog('Acs', 'library %s not found', [Name]);
    Exit;
  end;
  M := TAcsModule.Create(Data);
  if M.Error <> '' then
  begin
    WritelnLog('Acs', 'library %s not loaded: %s', [Name, M.Error]);
    FreeAndNil(M);
    Exit;
  end;
  WritelnLog('Acs', 'library %s in the %s format: %d scripts, %d functions, %d strings', [UpperCase(Name),
    M.FormatName, Length(M.Scripts), Length(M.Functions), Length(M.Strings)]);
  Result := AddModule(M, UpperCase(Name));
  Link;
end;

procedure TAcsVM.Link;
var
  L, O: TAcsLoaded;
  I, K, J: Integer;
  Name: String;
  Found: Boolean;

  { Function J of L is Name's in O (module K), when O has it. }
  function LinkFunction(const Other: TAcsLoaded; const K2: Integer; const FuncName: String;
    const J: Integer): Boolean;
  var
    J2: Integer;
  begin
    for J2 := 0 to Min(High(Other.Module.FunctionNames), High(Other.Module.Functions)) do
      if (Other.Module.Functions[J2].Address <> 0) and SameText(Other.Module.FunctionNames[J2], FuncName) then
      begin
        L.FuncModule[J] := K2;
        L.FuncIndex[J] := J2;
        Exit(true);
      end;
    Result := false;
  end;

  procedure LinkVar(const Index: Integer; const VarName: String);
  var
    K2, J2: Integer;
  begin
    if (Index < 0) or (Index >= AcsMapVarCount) then Exit;
    for K2 := 0 to FMods.Count - 1 do
      if Mods(K2) <> L then
        for J2 := 0 to Min(High(Mods(K2).Module.VarExports), AcsMapVarCount - 1) do
          if SameText(Mods(K2).Module.VarExports[J2], VarName) then
          begin
            L.VarModule[Index] := K2;
            L.VarIndex[Index] := J2;
            Exit;
          end;
    WritelnLog('Acs', 'imported variable %s not found', [VarName]);
  end;

begin
  for I := 0 to FMods.Count - 1 do
  begin
    L := Mods(I);
    for K := 0 to High(L.Module.VarImports) do
      LinkVar(L.Module.VarImports[K].Index, L.Module.VarImports[K].Name);
    for K := 0 to High(L.Module.ArrayImports) do
      LinkVar(L.Module.ArrayImports[K].Index, L.Module.ArrayImports[K].Name);
    { Imported functions: no address, found by name. }
    for J := 0 to High(L.Module.Functions) do
    begin
      if (L.Module.Functions[J].Address <> 0) or (J > High(L.Module.FunctionNames)) then Continue;
      Name := L.Module.FunctionNames[J];
      Found := false;
      for K := 0 to FMods.Count - 1 do
        if (not Found) and (Mods(K) <> L) then
        begin
          O := Mods(K);
          Found := LinkFunction(O, K, Name, J);
        end;
      if not Found then
        WritelnLog('Acs', 'imported function %s not found', [Name]);
    end;
  end;
end;

function TAcsVM.Inst(const I: Integer): TAcsInstance;
begin
  Result := TAcsInstance(FInstances[I]);
end;

function TAcsVM.InstanceCount: Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to FInstances.Count - 1 do
    if Inst(I).State <> asDone then Inc(Result);
end;

function TAcsVM.MapVar(const Index: Integer): Integer;
begin
  if (Index >= 0) and (Index < AcsMapVarCount) then Result := Mods(0).MapVars[Index] else Result := 0;
end;

procedure TAcsVM.LogOnce(const What: String);
begin
  if FLogged.IndexOf(What) >= 0 then Exit;
  FLogged.Add(What);
  WritelnLog('Acs', '%s not supported, skipped', [What]);
end;

procedure TAcsVM.Stop(const I: TAcsInstance; const Why: String);
begin
  WritelnLog('Acs', 'script %d stopped: %s', [I.Number, Why]);
  I.State := asDone;
end;

function TAcsVM.StringOf(const Index: Integer): String;
var
  I: Integer;
begin
  I := Index and $FFFF;
  if Index >= AcsDynamicStringBase then
  begin
    I := Index - AcsDynamicStringBase;
    if I <= High(FDynStrings) then Exit(FDynStrings[I]);
    Exit('');
  end;
  Result := '';
  if (Index shr 16 >= 0) and (Index shr 16 < FMods.Count) then
    if (I >= 0) and (I <= High(Mods(Index shr 16).Module.Strings)) then
      Result := Mods(Index shr 16).Module.Strings[I];
end;

function TAcsVM.NewString(const S: String): Integer;
begin
  SetLength(FDynStrings, Length(FDynStrings) + 1);
  FDynStrings[High(FDynStrings)] := S;
  Result := AcsDynamicStringBase + High(FDynStrings);
end;

function TAcsVM.CallFunc(const I: TAcsInstance; const Index: Integer; const Args: array of Integer): Integer;
var
  Number, K: Integer;
  X: TAcsInstance;
  S, T: String;

  function Arg(const N: Integer): Integer;
  begin
    if N <= High(Args) then Result := Args[N] else Result := 0;
  end;

  { The named script of Arg(0); false (logged) when there is none. }
  function Named: Boolean;
  begin
    Result := NamedScript(StringOf(Arg(0)), Number);
    if not Result then
      WritelnLog('Acs', 'script "%s" not found', [StringOf(Arg(0))]);
  end;

  function Fixed(const F: Double): Integer;
  begin
    Result := Wrap(Round(F * 65536));
  end;

  { Thing id Tid, 0 the script's activator. }
  function ActorTid(const Tid: Integer): Integer;
  begin
    if Tid = 0 then Result := I.ActivatorTid else Result := Tid;
  end;

begin
  Result := 0;
  case Index of
    AcsfACSNamedExecute, AcsfACSNamedExecuteAlways:
      if Named and FHost.ThisMap(Arg(1)) then
        Result := Ord(StartScript(Number, [Arg(2), Arg(3), Arg(4)], I.Activator, I.Line, I.BackSide,
          Index = AcsfACSNamedExecuteAlways) <> nil);
    AcsfACSNamedLockedExecute, AcsfACSNamedLockedExecuteDoor:
      if Named and FHost.ThisMap(Arg(1)) and FHost.CheckLock(Arg(4)) then
        Result := Ord(StartScript(Number, [Arg(2), Arg(3)], I.Activator, I.Line, I.BackSide, false) <> nil);
    AcsfACSNamedExecuteWithResult:
      if Named then
      begin
        X := StartScript(Number, [Arg(1), Arg(2), Arg(3), Arg(4)], I.Activator, I.Line, I.BackSide, true);
        if X <> nil then
        begin
          Run(X);
          Result := X.ResultValue;
        end;
      end;
    AcsfACSNamedSuspend:
      if Named then
      begin
        SuspendScript(Number);
        Result := 1;
      end;
    AcsfACSNamedTerminate:
      if Named then
      begin
        TerminateScript(Number);
        Result := 1;
      end;
    AcsfSqrt: Result := Trunc(Sqrt(Max(0, Arg(0))));
    AcsfFixedSqrt: Result := Fixed(Sqrt(Max(0, Arg(0)) / 65536));
    AcsfVectorLength: Result := Fixed(Sqrt(Sqr(Arg(0) / 65536) + Sqr(Arg(1) / 65536)));
    AcsfFloor: Result := Arg(0) and Integer($FFFF0000);
    AcsfCeil: Result := Wrap((Int64(Arg(0)) + $FFFF) and not Int64($FFFF));
    AcsfRound: Result := Wrap((Int64(Arg(0)) + $8000) and not Int64($FFFF));
    Acsfstrcmp, Acsfstricmp:
      begin
        S := StringOf(Arg(0));
        T := StringOf(Arg(1));
        if High(Args) >= 2 then
        begin
          S := Copy(S, 1, Max(0, Arg(2)));
          T := Copy(T, 1, Max(0, Arg(2)));
        end;
        if Index = Acsfstricmp then
          Result := Sign(CompareText(S, T))
        else
          Result := Sign(CompareStr(S, T));
      end;
    AcsfStrLeft: Result := NewString(Copy(StringOf(Arg(0)), 1, Max(0, Arg(1))));
    AcsfStrRight:
      begin
        S := StringOf(Arg(0));
        K := Max(0, Min(Length(S), Arg(1)));
        Result := NewString(Copy(S, Length(S) - K + 1, K));
      end;
    AcsfStrMid: Result := NewString(Copy(StringOf(Arg(0)), Max(0, Arg(1)) + 1, Max(0, Arg(2))));
    AcsfGetChar:
      begin
        S := StringOf(Arg(0));
        if (Arg(1) >= 0) and (Arg(1) < Length(S)) then Result := Ord(S[Arg(1) + 1]);
      end;
    AcsfCheckSight: Result := Ord(FHost.CheckSight(I, Arg(0), Arg(1)));
    AcsfIsTIDUsed: Result := Ord(FHost.TidUsed(Arg(0)));
    AcsfUniqueTID:
      begin
        K := Max(1, Arg(0));
        while FHost.TidUsed(K) and (K < 32767) do Inc(K);
        Result := K;
      end;
    AcsfGetActorVelX, AcsfGetActorVelY, AcsfGetActorVelZ:
      Result := FHost.ActorValue(I, Arg(0), 7 + Index - AcsfGetActorVelX);
    AcsfDamageActor: Result := FHost.DamageThing(I, Arg(0), Arg(4));
    AcsfGetWeapon: Result := NewString(FHost.WeaponName);
    AcsfSpawnForced: Result := FHost.Spawn(StringOf(Arg(0)), Arg(1) / 65536, Arg(2) / 65536, Arg(4),
      Arg(5) * 360 / 256);
    AcsfSpawnSpotForced: Result := FHost.SpawnSpot(StringOf(Arg(0)), Arg(1), Arg(2), Arg(3) * 360 / 256, false);
    AcsfSpawnSpotFacingForced: Result := FHost.SpawnSpot(StringOf(Arg(0)), Arg(1), Arg(2), 0, true);
    AcsfPlaySound:
      begin
        if Length(Args) >= 2 then
          FHost.PlaySound(I, StringOf(Arg(1)), 127, Arg(0));
      end;
    AcsfSetMusicVolume: ;
    { HUD messages are printed as plain messages: no clipping or wrapping. }
    AcsfSetHUDClipRect, AcsfSetHUDWrapWidth: ;
    AcsfGetUserVariable: Result := UserVar(ActorTid(Arg(0)), StringOf(Arg(1)), 0);
    AcsfSetUserVariable: SetUserVar(ActorTid(Arg(0)), StringOf(Arg(1)), 0, Arg(2));
    AcsfGetUserArray: Result := UserVar(ActorTid(Arg(0)), StringOf(Arg(1)), Arg(2));
    AcsfSetUserArray: SetUserVar(ActorTid(Arg(0)), StringOf(Arg(1)), Arg(2), Arg(3));
    AcsfSetCVar, AcsfSetUserCVar:
      begin
        if Index = AcsfSetCVar then S := StringOf(Arg(0)) else S := StringOf(Arg(1));
        K := FGlobals.CVarIndex(S, true);
        if Index = AcsfSetCVar then FGlobals.CVarValues[K] := Arg(1) else FGlobals.CVarValues[K] := Arg(2);
        FGlobals.CVarTexts[K] := IntToStr(FGlobals.CVarValues[K]);
        WritelnLog('Acs', 'CVar %s = %d', [FGlobals.CVarNames[K], FGlobals.CVarValues[K]]);
        Result := 1;
      end;
    AcsfSetCVarString, AcsfSetUserCVarString:
      begin
        if Index = AcsfSetCVarString then
        begin
          S := StringOf(Arg(0));
          T := StringOf(Arg(1));
        end else
        begin
          S := StringOf(Arg(1));
          T := StringOf(Arg(2));
        end;
        K := FGlobals.CVarIndex(S, true);
        FGlobals.CVarTexts[K] := T;
        FGlobals.CVarValues[K] := StrToIntDef(T, 0);
        WritelnLog('Acs', 'CVar %s = "%s"', [FGlobals.CVarNames[K], T]);
        Result := 1;
      end;
    AcsfGetUserCVar: Result := CVar(StringOf(Arg(1)));
    AcsfGetCVarString, AcsfGetUserCVarString:
      begin
        if Index = AcsfGetCVarString then S := StringOf(Arg(0)) else S := StringOf(Arg(1));
        K := FGlobals.CVarIndex(S, false);
        if K >= 0 then
          Result := NewString(FGlobals.CVarTexts[K])
        else
          Result := NewString(IntToStr(CVar(S)));
      end;
    else
      LogOnce(SysUtils.Format('ACS function %d', [Index]));
  end;
end;

function TAcsVM.CVar(const Name: String): Integer;
var
  K: Integer;
begin
  K := FGlobals.CVarIndex(Name, false);
  if K >= 0 then Exit(FGlobals.CVarValues[K]);
  if SameText(Name, 'skill') or SameText(Name, 'gameskill') then Exit(FHost.GameSkill);
  { Single player: no deathmatch, teams or cheats rules to report. }
  if not (SameText(Name, 'deathmatch') or SameText(Name, 'teamplay') or SameText(Name, 'sv_cheats')) then
    LogOnce(SysUtils.Format('CVar "%s"', [Name]));
  Result := 0;
end;

function TAcsVM.UserVar(const Tid: Integer; const Name: String; const Index: Integer): Integer;
var
  Key: String;
  I: Integer;
begin
  Key := SysUtils.Format('%d %s %d', [Tid, LowerCase(Name), Index]);
  for I := 0 to High(FUserKeys) do
    if FUserKeys[I] = Key then Exit(FUserValues[I]);
  Result := 0;
end;

procedure TAcsVM.SetUserVar(const Tid: Integer; const Name: String; const Index, Value: Integer);
var
  Key: String;
  I: Integer;
begin
  Key := SysUtils.Format('%d %s %d', [Tid, LowerCase(Name), Index]);
  for I := 0 to High(FUserKeys) do
    if FUserKeys[I] = Key then
    begin
      FUserValues[I] := Value;
      Exit;
    end;
  I := Length(FUserKeys);
  SetLength(FUserKeys, I + 1);
  SetLength(FUserValues, I + 1);
  FUserKeys[I] := Key;
  FUserValues[I] := Value;
end;

function TAcsVM.Running(const Number: Integer): Boolean;
var
  I: Integer;
begin
  for I := 0 to FInstances.Count - 1 do
    if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then Exit(true);
  Result := false;
end;

function TAcsVM.FindScript(const Number: Integer; out ModIndex, ScriptIndex: Integer): Boolean;
var
  K, N, J: Integer;
begin
  Result := false;
  ModIndex := 0;
  ScriptIndex := -1;
  if Number >= 0 then
  begin
    for J := 0 to FMods.Count - 1 do
    begin
      ScriptIndex := Mods(J).Module.FindScript(Number);
      if ScriptIndex >= 0 then
      begin
        ModIndex := J;
        Exit(true);
      end;
    end;
    Exit;
  end;
  { Named scripts: -1 - their index across the modules' names. }
  K := -1 - Number;
  for J := 0 to FMods.Count - 1 do
  begin
    N := Length(Mods(J).Module.ScriptNames);
    if K < N then
    begin
      ModIndex := J;
      ScriptIndex := Mods(J).Module.FindScript(-1 - K);
      Exit(ScriptIndex >= 0);
    end;
    K := K - N;
  end;
end;

function TAcsVM.NamedScript(const Name: String; out Number: Integer): Boolean;
var
  M, Base, Local: Integer;
begin
  Base := 0;
  for M := 0 to FMods.Count - 1 do
  begin
    if Mods(M).Module.NamedScript(Name, Local) then
    begin
      Number := Local - Base;
      Exit(true);
    end;
    Base := Base + Length(Mods(M).Module.ScriptNames);
  end;
  Number := 0;
  Result := false;
end;

function TAcsVM.ConstCalls: TAcsConstCalls;
var
  M, K: Integer;
  C: TAcsConstCalls;
begin
  Result := nil;
  for M := 0 to FMods.Count - 1 do
  begin
    C := Mods(M).Module.ConstCalls;
    K := Length(Result);
    SetLength(Result, K + Length(C));
    if Length(C) > 0 then
      Move(C[0], Result[K], Length(C) * SizeOf(TAcsConstCall));
  end;
end;

function TAcsVM.StartScript(const Number: Integer; const Args: array of Integer; const Activator: TAcsActivator;
  const Line: Integer; const BackSide, Always: Boolean): TAcsInstance;
var
  M, S, I: Integer;
begin
  Result := nil;
  if not FindScript(Number, M, S) then
  begin
    WritelnLog('Acs', 'script %d not found', [Number]);
    Exit;
  end;
  if not Always then
    for I := 0 to FInstances.Count - 1 do
      if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then
      begin
        if Inst(I).State = asSuspended then
        begin
          Inst(I).State := asRunning;
          WritelnLog('Acs', 'script %d resumed', [Number]);
          Exit(Inst(I));
        end;
        Exit;
      end;
  Result := StartAt(M, S, Number, Args, Activator, Line, BackSide);
end;

function TAcsVM.StartAt(const ModIndex, ScriptIndex, Number: Integer; const Args: array of Integer;
  const Activator: TAcsActivator; const Line: Integer; const BackSide: Boolean): TAcsInstance;
var
  Info: TAcsScriptInfo;
  K: Integer;
begin
  Info := Mods(ModIndex).Module.Scripts[ScriptIndex];
  Result := TAcsInstance.Create;
  Result.Module := ModIndex;
  Result.ScriptModule := ModIndex;
  Result.Script := ScriptIndex;
  Result.Number := Number;
  Result.PC := Info.Address;
  Result.State := asRunning;
  SetLength(Result.Stack, Info.VarCount + 64);
  for K := 0 to High(Result.Stack) do Result.Stack[K] := 0;
  for K := 0 to Min(High(Args), Info.ArgCount - 1) do
    Result.Stack[K] := Args[K];
  Result.LocalsBase := 0;
  Result.SP := Info.VarCount;
  Result.Activator := Activator;
  Result.Line := Line;
  Result.BackSide := BackSide;
  Result.OptStart := -1;
  FInstances.Add(Result);
  Inc(FStarted);
  if ModIndex = 0 then
    WritelnLog('Acs', 'script %d (%s) started', [Number, AcsScriptTypeName(Info.ScriptType)])
  else
    WritelnLog('Acs', 'script %d (%s) of %s started', [Number, AcsScriptTypeName(Info.ScriptType),
      Mods(ModIndex).Name]);
end;

procedure TAcsVM.StartType(const ScriptType: Integer; const Activator: TAcsActivator);
var
  M, I, Number, Base, K: Integer;
  Md: TAcsModule;
begin
  Base := 0;
  for M := 0 to FMods.Count - 1 do
  begin
    Md := Mods(M).Module;
    for I := 0 to High(Md.Scripts) do
      if Md.Scripts[I].ScriptType = ScriptType then
      begin
        Number := Md.Scripts[I].Number;
        { A named script's number across the modules. }
        if Number < 0 then Number := Number - Base;
        K := I;
        StartAt(M, K, Number, [], Activator, -1, false);
      end;
    Base := Base + Length(Md.ScriptNames);
  end;
end;

procedure TAcsVM.StartLevel;
begin
  StartType(AcsOpen, aaWorld);
  StartType(AcsEnter, aaPlayer);
end;

procedure TAcsVM.TerminateScript(const Number: Integer);
var
  I: Integer;
begin
  for I := 0 to FInstances.Count - 1 do
    if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then
    begin
      Inst(I).State := asDone;
      WritelnLog('Acs', 'script %d terminated', [Number]);
    end;
end;

procedure TAcsVM.SuspendScript(const Number: Integer);
var
  I: Integer;
begin
  for I := 0 to FInstances.Count - 1 do
    if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then
      Inst(I).State := asSuspended;
end;

procedure TAcsVM.Tic;
var
  I, N: Integer;
  X: TAcsInstance;
begin
  N := FInstances.Count;
  for I := 0 to N - 1 do
  begin
    X := Inst(I);
    case X.State of
      asDelayed:
        begin
          Dec(X.StateData);
          if X.StateData <= 0 then X.State := asRunning;
        end;
      asTagWait:
        if not FHost.TagBusy(X.StateData) then X.State := asRunning;
      asScriptWaitPre:
        if Running(X.StateData) then X.State := asScriptWait;
      asScriptWait:
        if not Running(X.StateData) then X.State := asRunning;
    end;
    if X.State = asRunning then
      Run(X);
  end;
  for I := FInstances.Count - 1 downto 0 do
    if Inst(I).State = asDone then
      FInstances.Delete(I);
end;

{ The ACS_* actions run here; the rest go to the host. }
function TAcsVM.ActionSpecial(const I: TAcsInstance; const Special: Integer; const Args: TAcsArgs;
  out Value: Integer): Boolean;
var
  X: TAcsInstance;
begin
  Value := 1;
  Result := true;
  case Special of
    80, 226:
      begin
        if not FHost.ThisMap(Args[1]) then
        begin
          LogOnce('ACS_Execute on another map');
          Exit(false);
        end;
        Result := StartScript(Args[0], [Args[2], Args[3], Args[4]], I.Activator, I.Line, I.BackSide,
          Special = 226) <> nil;
      end;
    84:
      begin
        X := StartScript(Args[0], [Args[1], Args[2], Args[3], Args[4]], I.Activator, I.Line, I.BackSide, true);
        Value := 0;
        if X <> nil then
        begin
          Run(X);
          Value := X.ResultValue;
        end;
      end;
    81: TerminateScript(Args[0]);
    82: SuspendScript(Args[0]);
    else
      Value := FHost.LineSpecial(I, Special, Args);
  end;
  if not Result then Value := 0;
end;

procedure TAcsVM.Run(const I: TAcsInstance);
type
  TVarKind = (vkScript, vkMap, vkWorld, vkGlobal, vkMapArray, vkWorldArray, vkGlobalArray);
  TVarOp = (voAssign, voPush, voAdd, voSub, voMul, voDiv, voMod, voInc, voDec, voAnd, voEor, voOr, voLs, voRs);
var
  M: TAcsModule;
  Op, Count, A, B, K, N, Special, Target: Integer;
  Args: TAcsArgs;
  Kind: TVarKind;
  VOp: TVarOp;
  LevelName: String;
  FuncArgs: array of Integer;

  procedure Push(const V: Integer);
  begin
    if I.SP >= Length(I.Stack) then
    begin
      if Length(I.Stack) >= AcsMaxStack then
      begin
        Stop(I, 'stack overflow');
        Exit;
      end;
      SetLength(I.Stack, Length(I.Stack) * 2);
    end;
    I.Stack[I.SP] := V;
    Inc(I.SP);
  end;

  function Pop: Integer;
  begin
    if I.SP <= I.LocalsBase then Exit(0);
    Dec(I.SP);
    Result := I.Stack[I.SP];
  end;

  function Top: Integer;
  begin
    if I.SP <= I.LocalsBase then Exit(0);
    Result := I.Stack[I.SP - 1];
  end;

  procedure Drop(const N: Integer);
  begin
    I.SP := Max(I.LocalsBase, I.SP - N);
  end;

  procedure PopArgs(const N: Integer);
  var
    J: Integer;
  begin
    Args := Default(TAcsArgs);
    for J := N - 1 downto 0 do
      if J <= 4 then Args[J] := Pop else Pop;
  end;

  procedure DoSpecial(const Special: Integer; const PushResult: Boolean);
  var
    V: Integer;
  begin
    ActionSpecial(I, Special, Args, V);
    if PushResult then Push(V);
  end;

  { The skipped p-codes: N arguments popped, maybe a 0 pushed. }
  procedure Skip(const N: Integer; const PushZero: Boolean = false);
  begin
    LogOnce(AcsPcodeName(Op));
    Drop(N);
    if PushZero then Push(0);
  end;

  function Classify(const Op: Integer): Boolean;
  const
    Ops9: array [0..8] of TVarOp = (voAssign, voPush, voAdd, voSub, voMul, voDiv, voMod, voInc, voDec);
    ArrayOps9: array [0..8] of TVarOp = (voPush, voAssign, voAdd, voSub, voMul, voDiv, voMod, voInc, voDec);
    Bits: array [0..4] of TVarOp = (voAnd, voEor, voOr, voLs, voRs);
  begin
    Result := true;
    case Op of
      PcdAssignscriptvar..PcdDecworldvar:
        begin
          Kind := TVarKind((Op - PcdAssignscriptvar) mod 3);
          VOp := Ops9[(Op - PcdAssignscriptvar) div 3];
        end;
      PcdAssignglobalvar..PcdDecglobalvar:
        begin
          Kind := vkGlobal;
          VOp := Ops9[Op - PcdAssignglobalvar];
        end;
      PcdPushmaparray..PcdDecmaparray:
        begin
          Kind := vkMapArray;
          VOp := ArrayOps9[Op - PcdPushmaparray];
        end;
      PcdPushworldarray..PcdDecworldarray:
        begin
          Kind := vkWorldArray;
          VOp := ArrayOps9[Op - PcdPushworldarray];
        end;
      PcdPushglobalarray..PcdDecglobalarray:
        begin
          Kind := vkGlobalArray;
          VOp := ArrayOps9[Op - PcdPushglobalarray];
        end;
      PcdAndscriptvar..PcdRsglobalarray:
        begin
          Kind := TVarKind((Op - PcdAndscriptvar) mod 7);
          VOp := Bits[(Op - PcdAndscriptvar) div 7];
        end;
      else Result := false;
    end;
  end;

  { A variable op on Kind's variable Index. }
  procedure VarOp(const Index: Integer);
  var
    Elem, Value, Old, NewValue, ArrNum, VI: Integer;
    Ok: Boolean;
    L: TAcsLoaded;
  begin
    { Map variables: through the module's imports. }
    L := Mods(I.Module);
    VI := Index;
    if (Kind in [vkMap, vkMapArray]) and (Index >= 0) and (Index < AcsMapVarCount) then
    begin
      VI := L.VarIndex[Index];
      L := Mods(L.VarModule[Index]);
    end;
    Elem := 0;
    Value := 0;
    if not (VOp in [voPush, voInc, voDec]) then Value := Pop;
    if Kind in [vkMapArray, vkWorldArray, vkGlobalArray] then Elem := Pop;
    Ok := true;
    ArrNum := 0;
    { The old value. }
    case Kind of
      vkScript:
        begin
          Ok := (Index >= 0) and (I.LocalsBase + Index < I.SP);
          if Ok then Old := I.Stack[I.LocalsBase + Index] else Old := 0;
        end;
      vkMap: begin Ok := (VI >= 0) and (VI < AcsMapVarCount); if Ok then Old := L.MapVars[VI] else Old := 0; end;
      vkWorld: begin Ok := (Index >= 0) and (Index < AcsWorldVarCount); if Ok then Old := FGlobals.WorldVars[Index] else Old := 0; end;
      vkGlobal: begin Ok := (Index >= 0) and (Index < AcsGlobalVarCount); if Ok then Old := FGlobals.GlobalVars[Index] else Old := 0; end;
      vkMapArray:
        begin
          Ok := (VI >= 0) and (VI < AcsMapVarCount);
          if Ok then ArrNum := L.MapVars[VI];
          Ok := Ok and (ArrNum >= 0) and (ArrNum <= High(L.MapArrays)) and (Elem >= 0) and
            (Elem <= High(L.MapArrays[ArrNum]));
          if Ok then Old := L.MapArrays[ArrNum][Elem] else Old := 0;
        end;
      vkWorldArray: Old := FGlobals.GetArray(Index, Elem);
      else Old := FGlobals.GetArray(AcsWorldVarCount + Index, Elem);
    end;
    case VOp of
      voPush:
        begin
          Push(Old);
          Exit;
        end;
      voAssign: NewValue := Value;
      voAdd: NewValue := Wrap(Int64(Old) + Value);
      voSub: NewValue := Wrap(Int64(Old) - Value);
      voMul: NewValue := Wrap(Int64(Old) * Value);
      voDiv, voMod:
        begin
          if Value = 0 then
          begin
            Stop(I, 'division by zero');
            Exit;
          end;
          if VOp = voDiv then NewValue := Wrap(Int64(Old) div Value) else NewValue := Wrap(Int64(Old) mod Value);
        end;
      voInc: NewValue := Wrap(Int64(Old) + 1);
      voDec: NewValue := Wrap(Int64(Old) - 1);
      voAnd: NewValue := Old and Value;
      voEor: NewValue := Old xor Value;
      voOr: NewValue := Old or Value;
      voLs: NewValue := Wrap(Int64(Old) shl (Value and 31));
      else NewValue := SarLongint(Old, Value and 31);
    end;
    if not Ok then Exit;
    case Kind of
      vkScript: I.Stack[I.LocalsBase + Index] := NewValue;
      vkMap: L.MapVars[VI] := NewValue;
      vkWorld: FGlobals.WorldVars[Index] := NewValue;
      vkGlobal: FGlobals.GlobalVars[Index] := NewValue;
      vkMapArray: L.MapArrays[ArrNum][Elem] := NewValue;
      vkWorldArray: FGlobals.SetArray(Index, Elem, NewValue);
      else FGlobals.SetArray(AcsWorldVarCount + Index, Elem, NewValue);
    end;
  end;

  procedure Jump(const Ofs: Integer);
  begin
    I.PC := Ofs;
  end;

  { Function F of module Lib (an import runs its library's). }
  procedure CallFunction(const Lib, FuncNum: Integer; const Discard: Boolean);
  var
    J, Fr, F, FM: Integer;
    L: TAcsLoaded;
  begin
    if (Lib < 0) or (Lib >= FMods.Count) or (FuncNum < 0) or (FuncNum > High(Mods(Lib).FuncModule)) then
    begin
      Stop(I, SysUtils.Format('function %d not found', [FuncNum]));
      Exit;
    end;
    FM := Mods(Lib).FuncModule[FuncNum];
    F := Mods(Lib).FuncIndex[FuncNum];
    L := Mods(FM);
    if (F > High(L.Module.Functions)) or (L.Module.Functions[F].Address = 0) then
    begin
      Stop(I, SysUtils.Format('function %d not found', [FuncNum]));
      Exit;
    end;
    if Length(I.Frames) >= 1000 then
    begin
      Stop(I, 'functions nested too deep');
      Exit;
    end;
    Fr := Length(I.Frames);
    SetLength(I.Frames, Fr + 1);
    I.Frames[Fr].ReturnPC := I.PC;
    I.Frames[Fr].LocalsBase := I.LocalsBase;
    I.Frames[Fr].Discard := Discard;
    I.Frames[Fr].ReturnModule := I.Module;
    I.LocalsBase := Max(0, I.SP - L.Module.Functions[F].ArgCount);
    for J := 1 to L.Module.Functions[F].LocalCount do Push(0);
    I.Module := FM;
    M := L.Module;
    I.PC := L.Module.Functions[F].Address;
  end;

  procedure ReturnFrom(const Value: Integer);
  var
    Fr: Integer;
  begin
    Fr := High(I.Frames);
    if Fr < 0 then
    begin
      I.State := asDone;
      Exit;
    end;
    I.SP := I.LocalsBase;
    I.LocalsBase := I.Frames[Fr].LocalsBase;
    I.PC := I.Frames[Fr].ReturnPC;
    I.Module := Max(0, Min(FMods.Count - 1, I.Frames[Fr].ReturnModule));
    M := Mods(I.Module).Module;
    if not I.Frames[Fr].Discard then Push(Value);
    SetLength(I.Frames, Fr);
  end;

  procedure Print(const Kind: TAcsPrintKind);
  var
    S: String;
  begin
    S := I.PrintText;
    I.PrintText := '';
    FHost.Print(I, S, Kind);
  end;

  function BinaryText(V: Cardinal): String;
  begin
    Result := '';
    repeat
      Result := Chr(Ord('0') + (V and 1)) + Result;
      V := V shr 1;
    until V = 0;
  end;

  { The fixed point number V as text, like ZDoom's %g. }
  function FixedText(const V: Integer): String;
  begin
    Result := FloatToStr(V / 65536, DefaultFormatSettings);
    Result := StringReplace(Result, DefaultFormatSettings.DecimalSeparator, '.', []);
  end;

  procedure PrintArray(const ArrayKind: TVarKind; const Index, Offset: Integer);
  var
    J, C, ArrNum: Integer;
    L: TAcsLoaded;
  begin
    J := Offset;
    while J - Offset < 4096 do
    begin
      case ArrayKind of
        vkMapArray:
          begin
            if (Index < 0) or (Index >= AcsMapVarCount) then Exit;
            L := Mods(Mods(I.Module).VarModule[Index]);
            ArrNum := L.MapVars[Mods(I.Module).VarIndex[Index]];
            if (ArrNum < 0) or (ArrNum > High(L.MapArrays)) or (J < 0) or (J > High(L.MapArrays[ArrNum])) then Exit;
            C := L.MapArrays[ArrNum][J];
          end;
        vkWorldArray: C := FGlobals.GetArray(Index, J);
        else C := FGlobals.GetArray(AcsWorldVarCount + Index, J);
      end;
      if C = 0 then Exit;
      I.PrintText := I.PrintText + Chr(C and 255);
      Inc(J);
    end;
  end;

  { A string constant of the running module's code (direct p-codes). }
  function DirectString(const Index: Integer): String;
  begin
    Result := StringOf((Index and $FFFF) or (I.Module shl 16));
  end;

begin
  if (I.Module < 0) or (I.Module >= FMods.Count) then I.Module := 0;
  M := Mods(I.Module).Module;
  Count := 0;
  while I.State = asRunning do
  begin
    Inc(Count);
    if Count > AcsRunawayLimit then
    begin
      Stop(I, 'runaway script (too many instructions in one tic)');
      Exit;
    end;
    if (I.PC < 0) or (I.PC >= Length(M.Data)) then
    begin
      Stop(I, 'jumped out of the code');
      Exit;
    end;
    Op := M.ReadCode(I.PC);
    if Classify(Op) then
    begin
      VarOp(M.ReadByte(I.PC));
      Continue;
    end;
    case Op of
      PcdNop: ;
      PcdTerminate: I.State := asDone;
      PcdSuspend: I.State := asSuspended;
      PcdRestart:
        begin
          I.Module := I.ScriptModule;
          M := Mods(I.Module).Module;
          SetLength(I.Frames, 0);
          I.PC := M.Scripts[I.Script].Address;
        end;
      PcdPushnumber: Push(M.ReadWord(I.PC));
      PcdPushbyte: Push(M.RawByte(I.PC));
      PcdPush2bytes..PcdPush5bytes:
        for K := 1 to Op - PcdPush2bytes + 2 do Push(M.RawByte(I.PC));
      PcdPushbytes:
        begin
          N := M.RawByte(I.PC);
          for K := 1 to N do Push(M.RawByte(I.PC));
        end;
      PcdLspec1..PcdLspec5:
        begin
          Special := M.ReadByte(I.PC);
          PopArgs(Op - PcdLspec1 + 1);
          DoSpecial(Special, false);
        end;
      PcdLspec1direct..PcdLspec5direct:
        begin
          Special := M.ReadByte(I.PC);
          Args := Default(TAcsArgs);
          for K := 0 to Op - PcdLspec1direct do Args[K] := M.ReadWord(I.PC);
          DoSpecial(Special, false);
        end;
      PcdLspec1directb..PcdLspec5directb:
        begin
          Special := M.RawByte(I.PC);
          Args := Default(TAcsArgs);
          for K := 0 to Op - PcdLspec1directb do Args[K] := M.RawByte(I.PC);
          DoSpecial(Special, false);
        end;
      PcdLspec5result:
        begin
          Special := M.ReadByte(I.PC);
          PopArgs(5);
          DoSpecial(Special, true);
        end;
      PcdLspec5ex, PcdLspec5exresult:
        begin
          Special := M.ReadWord(I.PC);
          PopArgs(5);
          DoSpecial(Special, Op = PcdLspec5exresult);
        end;
      PcdAdd: begin B := Pop; A := Pop; Push(Wrap(Int64(A) + B)); end;
      PcdSubtract: begin B := Pop; A := Pop; Push(Wrap(Int64(A) - B)); end;
      PcdMultiply: begin B := Pop; A := Pop; Push(Wrap(Int64(A) * B)); end;
      PcdDivide, PcdModulus:
        begin
          B := Pop;
          A := Pop;
          if B = 0 then
          begin
            Stop(I, 'division by zero');
            Exit;
          end;
          if Op = PcdDivide then Push(Wrap(Int64(A) div B)) else Push(Wrap(Int64(A) mod B));
        end;
      PcdEq: begin B := Pop; A := Pop; Push(Ord(A = B)); end;
      PcdNe: begin B := Pop; A := Pop; Push(Ord(A <> B)); end;
      PcdLt: begin B := Pop; A := Pop; Push(Ord(A < B)); end;
      PcdGt: begin B := Pop; A := Pop; Push(Ord(A > B)); end;
      PcdLe: begin B := Pop; A := Pop; Push(Ord(A <= B)); end;
      PcdGe: begin B := Pop; A := Pop; Push(Ord(A >= B)); end;
      PcdAndlogical: begin B := Pop; A := Pop; Push(Ord((A <> 0) and (B <> 0))); end;
      PcdOrlogical: begin B := Pop; A := Pop; Push(Ord((A <> 0) or (B <> 0))); end;
      PcdAndbitwise: begin B := Pop; A := Pop; Push(A and B); end;
      PcdOrbitwise: begin B := Pop; A := Pop; Push(A or B); end;
      PcdEorbitwise: begin B := Pop; A := Pop; Push(A xor B); end;
      PcdNegatelogical: Push(Ord(Pop = 0));
      PcdNegatebinary: Push(not Pop);
      PcdLshift: begin B := Pop; A := Pop; Push(Wrap(Int64(A) shl (B and 31))); end;
      PcdRshift: begin B := Pop; A := Pop; Push(SarLongint(A, B and 31)); end;
      PcdUnaryminus: Push(Wrap(-Int64(Pop)));
      PcdGoto: Jump(M.ReadWord(I.PC));
      PcdIfgoto:
        begin
          Target := M.ReadWord(I.PC);
          if Pop <> 0 then Jump(Target);
        end;
      PcdIfnotgoto:
        begin
          Target := M.ReadWord(I.PC);
          if Pop = 0 then Jump(Target);
        end;
      PcdCasegoto:
        begin
          A := M.ReadWord(I.PC);
          Target := M.ReadWord(I.PC);
          if Top = A then
          begin
            Drop(1);
            Jump(Target);
          end;
        end;
      PcdCasegotosorted:
        begin
          I.PC := (I.PC + 3) and not 3;
          N := M.ReadWord(I.PC);
          A := Top;
          Target := -1;
          for K := 0 to N - 1 do
          begin
            B := M.ReadWord(I.PC);
            if (B = A) and (Target < 0) then
              Target := M.ReadWord(I.PC)
            else
              M.ReadWord(I.PC);
          end;
          if Target >= 0 then
          begin
            Drop(1);
            Jump(Target);
          end;
        end;
      PcdDrop: Drop(1);
      PcdDup: Push(Top);
      PcdSwap:
        if I.SP - 2 >= I.LocalsBase then
        begin
          A := I.Stack[I.SP - 1];
          I.Stack[I.SP - 1] := I.Stack[I.SP - 2];
          I.Stack[I.SP - 2] := A;
        end;
      PcdDelay, PcdDelaydirect, PcdDelaydirectb:
        begin
          case Op of
            PcdDelay: A := Pop;
            PcdDelaydirect: A := M.ReadWord(I.PC);
            else A := M.RawByte(I.PC);
          end;
          if A > 0 then
          begin
            I.State := asDelayed;
            I.StateData := A;
          end;
        end;
      PcdRandom, PcdRandomdirect, PcdRandomdirectb:
        begin
          case Op of
            PcdRandom: begin B := Pop; A := Pop; end;
            PcdRandomdirect: begin A := M.ReadWord(I.PC); B := M.ReadWord(I.PC); end;
            else begin A := M.RawByte(I.PC); B := M.RawByte(I.PC); end;
          end;
          if B < A then
          begin
            K := A; A := B; B := K;
          end;
          Push(Wrap(Int64(A) + FHost.Random(Integer(Min(Int64(B) - A + 1, High(Integer))))));
        end;
      PcdThingcount: begin B := Pop; A := Pop; Push(FHost.ThingCount(A, B)); end;
      PcdThingcountdirect: begin A := M.ReadWord(I.PC); B := M.ReadWord(I.PC); Push(FHost.ThingCount(A, B)); end;
      PcdThingcountname: begin B := Pop; A := Pop; Push(FHost.ThingCountName(StringOf(A), B)); end;
      PcdTagwait, PcdTagwaitdirect:
        begin
          if Op = PcdTagwait then A := Pop else A := M.ReadWord(I.PC);
          I.State := asTagWait;
          I.StateData := A;
        end;
      { No polyobjects: their waits end at once. }
      PcdPolywait: Drop(1);
      PcdPolywaitdirect: M.ReadWord(I.PC);
      PcdScriptwait, PcdScriptwaitdirect, PcdScriptwaitnamed:
        begin
          if Op = PcdScriptwait then A := Pop
          else if Op = PcdScriptwaitnamed then
          begin
            if not NamedScript(StringOf(Pop), A) then A := 0;
          end else
            A := M.ReadWord(I.PC);
          I.StateData := A;
          if Running(A) then I.State := asScriptWait else I.State := asScriptWaitPre;
        end;
      PcdChangefloor, PcdChangeceiling:
        begin
          B := Pop;
          A := Pop;
          FHost.ChangeFlat(A, StringOf(B), Op = PcdChangeceiling);
        end;
      PcdChangefloordirect, PcdChangeceilingdirect:
        begin
          A := M.ReadWord(I.PC);
          B := M.ReadWord(I.PC);
          FHost.ChangeFlat(A, DirectString(B), Op = PcdChangeceilingdirect);
        end;
      PcdLineside: Push(Ord(I.BackSide));
      PcdClearlinespecial: FHost.ClearLineSpecial(I.Line);
      PcdBeginprint: I.PrintText := '';
      PcdPrintstring: I.PrintText := I.PrintText + StringOf(Pop);
      PcdPrintlocalized: I.PrintText := I.PrintText + FHost.Localize(StringOf(Pop));
      PcdPrintnumber: I.PrintText := I.PrintText + IntToStr(Pop);
      PcdPrintcharacter: I.PrintText := I.PrintText + Chr(Pop and 255);
      PcdPrintfixed: I.PrintText := I.PrintText + FixedText(Pop);
      PcdPrintname: begin Drop(1); I.PrintText := I.PrintText + 'Player'; end;
      PcdPrintbinary: I.PrintText := I.PrintText + BinaryText(Cardinal(Pop));
      PcdPrinthex: I.PrintText := I.PrintText + IntToHex(Cardinal(Pop), 1);
      PcdPrintbind: begin Drop(1); I.PrintText := I.PrintText + '???'; end;
      PcdPrintmapchararray, PcdPrintworldchararray, PcdPrintglobalchararray:
        begin
          A := Pop;
          B := Pop;
          case Op of
            PcdPrintmapchararray: PrintArray(vkMapArray, A, B);
            PcdPrintworldchararray: PrintArray(vkWorldArray, A, B);
            else PrintArray(vkGlobalArray, A, B);
          end;
        end;
      PcdEndprint: Print(apPrint);
      PcdEndprintbold: Print(apBold);
      PcdEndlog: Print(apLog);
      PcdMorehudmessage: I.OptStart := -1;
      PcdOpthudmessage: I.OptStart := I.SP;
      PcdEndhudmessage, PcdEndhudmessagebold:
        begin
          if I.OptStart < 0 then I.OptStart := I.SP;
          I.SP := Max(I.LocalsBase, I.OptStart - 6);
          I.OptStart := -1;
          if Op = PcdEndhudmessagebold then Print(apBold) else Print(apHud);
        end;
      PcdSavestring:
        begin
          SetLength(FDynStrings, Length(FDynStrings) + 1);
          FDynStrings[High(FDynStrings)] := I.PrintText;
          I.PrintText := '';
          Push(AcsDynamicStringBase + High(FDynStrings));
        end;
      PcdStrlen: Push(Length(StringOf(Pop)));
      PcdTagstring:
        if I.SP > I.LocalsBase then
          I.Stack[I.SP - 1] := I.Stack[I.SP - 1] or (I.Module shl 16);
      PcdPlayercount, PcdSingleplayer: Push(1);
      PcdGametype, PcdIsnetworkgame, PcdPlayerteam, PcdPlayerfrags, PcdPlayernumber, PcdBlueteamcount..PcdGetinvasionstate,
      PcdGetsigilpieces:
        Push(0);
      PcdGameskill: Push(FHost.GameSkill);
      PcdPlayerexpert: Push(Ord(FHost.GameSkill >= 3));
      PcdTimer: Push(FHost.LevelTime);
      PcdPlayerhealth: Push(FHost.PlayerHealth);
      PcdPlayerarmorpoints: Push(FHost.PlayerArmor);
      PcdPlayerblueskull..PcdPlayermastercard, PcdPlayerblackskull..PcdPlayersilvercard:
        Push(Ord(FHost.PlayerHasKey(Op - PcdPlayerblueskull)));
      PcdPlayeringame: begin A := Pop; Push(Ord(A = 0)); end;
      PcdPlayerisbot: begin Drop(1); Push(0); end;
      PcdActivatortid: Push(I.ActivatorTid);
      PcdSectorsound, PcdAmbientsound, PcdLocalambientsound, PcdActivatorsound:
        begin
          B := Pop;
          A := Pop;
          case Op of
            PcdSectorsound: FHost.PlaySound(I, StringOf(A), B, -1);
            PcdActivatorsound: FHost.PlaySound(I, StringOf(A), B, 0);
            else FHost.PlaySound(I, StringOf(A), B, -2);
          end;
        end;
      PcdThingsound:
        begin
          B := Pop;
          A := Pop;
          K := Pop;
          if K <> 0 then FHost.PlaySound(I, StringOf(A), B, K);
        end;
      PcdSoundsequence: Skip(1);
      PcdSetlinetexture:
        begin
          A := Pop;
          K := Pop;
          B := Pop;
          N := Pop;
          FHost.SetLineTexture(N, B, K, StringOf(A));
        end;
      PcdSetlineblocking: begin B := Pop; A := Pop; FHost.SetLineBlocking(A, B); end;
      PcdSetlinemonsterblocking: begin B := Pop; A := Pop; FHost.SetLineMonsterBlocking(A, B <> 0); end;
      PcdSetlinespecial:
        begin
          PopArgs(5);
          Special := Pop;
          A := Pop;
          FHost.SetLineSpecial(A, Special, Args);
        end;
      PcdMusicchange: begin Drop(1); FHost.SetMusic(StringOf(Pop)); end;
      PcdSetmusic, PcdLocalsetmusic: begin Drop(2); FHost.SetMusic(StringOf(Pop)); end;
      PcdSetmusicdirect, PcdLocalsetmusicdirect:
        begin
          A := M.ReadWord(I.PC);
          M.ReadWord(I.PC);
          M.ReadWord(I.PC);
          FHost.SetMusic(DirectString(A));
        end;
      PcdFixedmul: begin B := Pop; A := Pop; Push(Wrap((Int64(A) * B) div 65536)); end;
      PcdFixeddiv:
        begin
          B := Pop;
          A := Pop;
          if B = 0 then
          begin
            Stop(I, 'division by zero');
            Exit;
          end;
          Push(Wrap((Int64(A) * 65536) div B));
        end;
      PcdSin: Push(Round(Sin(Pop / 65536 * 2 * Pi) * 65536));
      PcdCos: Push(Round(Cos(Pop / 65536 * 2 * Pi) * 65536));
      PcdVectorangle:
        begin
          B := Pop;
          A := Pop;
          if (A = 0) and (B = 0) then Push(0)
          else Push(Round(ArcTan2(B, A) / (2 * Pi) * 65536) and $FFFF);
        end;
      PcdGetactorx, PcdGetactory, PcdGetactorz, PcdGetactorangle, PcdGetactorfloorz, PcdGetactorceilingz,
      PcdGetactorlightlevel:
        begin
          A := Pop;
