          else FHost.Inventory(StringOf(A), -Max(0, B));
        end;
      PcdGiveinventorydirect, PcdTakeinventorydirect:
        begin
          A := M.ReadWord(I.PC);
          B := M.ReadWord(I.PC);
          if Op = PcdGiveinventorydirect then FHost.Inventory(DirectString(A), Max(0, B))
          else FHost.Inventory(DirectString(A), -Max(0, B));
        end;
      PcdCheckinventory: Push(FHost.Inventory(StringOf(Pop), 0));
      PcdCheckinventorydirect: Push(FHost.Inventory(DirectString(M.ReadWord(I.PC)), 0));
      PcdSetactorangle, PcdSetactorpitch, PcdSetammocapacity,
      PcdSetmarineweapon, PcdSetmarinesprite, PcdGrabinput, PcdMovemousepointer, PcdChangesky:
        Skip(2);
      PcdGetcvar: Push(CVar(StringOf(Pop)));
      PcdCheckweapon, PcdSetweapon, PcdGetammocapacity, PcdPlayerclass,
      PcdUseinventory, PcdClassifyactor, PcdCheckplayercamera, PcdGetlevelinfo:
        Skip(1, true);
      PcdGetactorproperty, PcdCheckactorinventory, PcdUseactorinventory, PcdCheckactorceilingtexture,
      PcdCheckactorfloortexture, PcdGetplayerinfo, PcdGetplayerinput, PcdUnmorphactor:
        Skip(2, true);
      PcdSetactorproperty, PcdSetcameratotexture, PcdSethudsize, PcdSetmousepointer, PcdConsolecommand,
      PcdReplacetextures, PcdGiveactorinventory, PcdTakeactorinventory:
        Skip(3);
      PcdSetactorstate, PcdThingdamage2: Skip(3, true);
      PcdTranslationrange1: Skip(4);
      { Spawn(class, x, y, z, tid, angle); SpawnSpot(class, spot, tid,
        angle); SpawnSpotFacing(class, spot, tid): angles in 256ths. }
      PcdSpawn, PcdSpawndirect:
        begin
          if Op = PcdSpawn then
          begin
            B := Pop;
            N := Pop;
            Drop(1);
            K := Pop;
            A := Pop;
            Target := Pop;
          end else
          begin
            Target := (M.ReadWord(I.PC) and $FFFF) or (I.Module shl 16);
            A := M.ReadWord(I.PC);
            K := M.ReadWord(I.PC);
            M.ReadWord(I.PC);
            N := M.ReadWord(I.PC);
            B := M.ReadWord(I.PC);
          end;
          Push(FHost.Spawn(StringOf(Target), A / 65536, K / 65536, N, B * 360 / 256));
        end;
      PcdSpawnspot, PcdSpawnspotdirect:
        begin
          if Op = PcdSpawnspot then
          begin
            B := Pop;
            N := Pop;
            K := Pop;
            Target := Pop;
          end else
          begin
            Target := (M.ReadWord(I.PC) and $FFFF) or (I.Module shl 16);
            K := M.ReadWord(I.PC);
            N := M.ReadWord(I.PC);
            B := M.ReadWord(I.PC);
          end;
          Push(FHost.SpawnSpot(StringOf(Target), K, N, B * 360 / 256, false));
        end;
      PcdSpawnspotfacing:
        begin
          N := Pop;
          K := Pop;
          Target := Pop;
          Push(FHost.SpawnSpot(StringOf(Target), K, N, 0, true));
        end;
      PcdSetactorposition: Skip(5, true);
      PcdFadeto, PcdSectordamage: Skip(5);
      PcdSpawnprojectile, PcdThingProjectile2, PcdSetthingspecial: Skip(7);
      PcdMorphactor: Skip(7, true);
      PcdTranslationrange2, PcdSetfloortrigger, PcdSetceilingtrigger: Skip(8);
      PcdFaderange: Skip(9);
      PcdConsolecommanddirect:
        begin
          Inc(I.PC, 12);
          Skip(0);
        end;
      PcdGetlinerowoffset: Push(0);
      PcdChangelevel:
        begin
          Drop(3);
          LevelName := StringOf(Pop);
          LogOnce('ChangeLevel (' + LevelName + ')');
        end;
      else
        begin
          Stop(I, SysUtils.Format('%s (p-code %d) not supported', [AcsPcodeName(Op), Op]));
          Exit;
        end;
    end;
  end;
end;

function TAcsVM.SaveState: TJSONObject;
var
  Arr, Sub, Fr: TJSONArray;
  J, K: Integer;
  X: TAcsInstance;
begin
  Result := TJSONObject.Create;
  Result.Add('mapVars', IntsToJson(Mods(0).MapVars));
  Arr := TJSONArray.Create;
  for J := 0 to High(Mods(0).MapArrays) do
    Arr.Add(IntsToJson(Mods(0).MapArrays[J]));
  Result.Add('mapArrays', Arr);
  { The libraries' variables: [name, map variables, map arrays]. }
  if FMods.Count > 1 then
  begin
    Arr := TJSONArray.Create;
    for J := 1 to FMods.Count - 1 do
    begin
      Sub := TJSONArray.Create;
      Sub.Add(Mods(J).Name);
      Sub.Add(IntsToJson(Mods(J).MapVars));
      Fr := TJSONArray.Create;
      for K := 0 to High(Mods(J).MapArrays) do
        Fr.Add(IntsToJson(Mods(J).MapArrays[K]));
      Sub.Add(Fr);
      Arr.Add(Sub);
    end;
    Result.Add('libraries', Arr);
  end;
  Arr := TJSONArray.Create;
  for J := 0 to High(FDynStrings) do Arr.Add(FDynStrings[J]);
  Result.Add('strings', Arr);
  Result.Add('started', FStarted);
  if Length(FUserKeys) > 0 then
  begin
    Arr := TJSONArray.Create;
    for J := 0 to High(FUserKeys) do
    begin
      Arr.Add(FUserKeys[J]);
      Arr.Add(FUserValues[J]);
    end;
    Result.Add('userVars', Arr);
  end;
  Arr := TJSONArray.Create;
  for J := 0 to FInstances.Count - 1 do
  begin
    X := Inst(J);
    if X.State = asDone then Continue;
    Sub := TJSONArray.Create;
    Sub.Add(X.Number);
    Sub.Add(X.PC);
    Sub.Add(Ord(X.State));
    Sub.Add(X.StateData);
    Sub.Add(X.LocalsBase);
    Sub.Add(Ord(X.Activator));
    Sub.Add(X.Line);
    Sub.Add(X.BackSide);
    Sub.Add(X.PrintText);
    Sub.Add(X.OptStart);
    Sub.Add(X.ResultValue);
    Sub.Add(X.ActivatorTid);
    Fr := TJSONArray.Create;
    for K := 0 to X.SP - 1 do Fr.Add(X.Stack[K]);
    Sub.Add(Fr);
    Fr := TJSONArray.Create;
    for K := 0 to High(X.Frames) do
    begin
      Fr.Add(X.Frames[K].ReturnPC);
      Fr.Add(X.Frames[K].LocalsBase);
      Fr.Add(X.Frames[K].Discard);
    end;
    Sub.Add(Fr);
    Sub.Add(X.Module);
    Sub.Add(X.ScriptModule);
    Fr := TJSONArray.Create;
    for K := 0 to High(X.Frames) do Fr.Add(X.Frames[K].ReturnModule);
    Sub.Add(Fr);
    Arr.Add(Sub);
  end;
  Result.Add('scripts', Arr);
end;

procedure TAcsVM.LoadState(const J: TJSONObject);
var
  Arr, Sub, Fr: TJSONArray;
  K, L, S, M: Integer;
  X: TAcsInstance;
  D: TJSONData;
begin
  if J = nil then Exit;
  IntsFromJson(J.Find('mapVars'), Mods(0).MapVars);
  D := J.Find('mapArrays');
  if D is TJSONArray then
    for K := 0 to Min(High(Mods(0).MapArrays), TJSONArray(D).Count - 1) do
      IntsFromJson(TJSONArray(D).Items[K], Mods(0).MapArrays[K]);
  D := J.Find('libraries');
  if D is TJSONArray then
    for K := 0 to TJSONArray(D).Count - 1 do
    begin
      if not (TJSONArray(D).Items[K] is TJSONArray) then Continue;
      Sub := TJSONArray(TJSONArray(D).Items[K]);
      if Sub.Count < 3 then Continue;
      for S := 1 to FMods.Count - 1 do
        if SameText(Mods(S).Name, Sub.Strings[0]) then
        begin
          IntsFromJson(Sub.Items[1], Mods(S).MapVars);
          if Sub.Items[2] is TJSONArray then
          begin
            Fr := TJSONArray(Sub.Items[2]);
            for L := 0 to Min(High(Mods(S).MapArrays), Fr.Count - 1) do
              IntsFromJson(Fr.Items[L], Mods(S).MapArrays[L]);
          end;
        end;
    end;
  D := J.Find('strings');
  SetLength(FDynStrings, 0);
  if D is TJSONArray then
  begin
    SetLength(FDynStrings, TJSONArray(D).Count);
    for K := 0 to High(FDynStrings) do FDynStrings[K] := TJSONArray(D).Strings[K];
  end;
  FStarted := J.Get('started', 0);
  SetLength(FUserKeys, 0);
  SetLength(FUserValues, 0);
  D := J.Find('userVars');
  if D is TJSONArray then
  begin
    SetLength(FUserKeys, TJSONArray(D).Count div 2);
    SetLength(FUserValues, Length(FUserKeys));
    for K := 0 to High(FUserKeys) do
    begin
      FUserKeys[K] := TJSONArray(D).Strings[K * 2];
      FUserValues[K] := TJSONArray(D).Integers[K * 2 + 1];
    end;
  end;
  FInstances.Clear;
  D := J.Find('scripts');
  if not (D is TJSONArray) then Exit;
  Arr := TJSONArray(D);
  for K := 0 to Arr.Count - 1 do
  begin
    if not (Arr.Items[K] is TJSONArray) then Continue;
    Sub := TJSONArray(Arr.Items[K]);
    if Sub.Count < 14 then Continue;
    if not FindScript(Sub.Integers[0], M, S) then Continue;
    X := TAcsInstance.Create;
    X.Script := S;
    X.ScriptModule := M;
    X.Module := M;
    if Sub.Count >= 16 then
    begin
      X.Module := EnsureRange(Sub.Integers[14], 0, FMods.Count - 1);
      X.ScriptModule := EnsureRange(Sub.Integers[15], 0, FMods.Count - 1);
    end;
    X.Number := Sub.Integers[0];
    X.PC := Sub.Integers[1];
    X.State := TAcsState(EnsureRange(Sub.Integers[2], 0, Ord(High(TAcsState))));
    X.StateData := Sub.Integers[3];
    X.LocalsBase := Sub.Integers[4];
    X.Activator := TAcsActivator(EnsureRange(Sub.Integers[5], 0, Ord(High(TAcsActivator))));
    X.Line := Sub.Integers[6];
    X.BackSide := Sub.Booleans[7];
    X.PrintText := Sub.Strings[8];
    X.OptStart := Sub.Integers[9];
    X.ResultValue := Sub.Integers[10];
    X.ActivatorTid := Sub.Integers[11];
    if Sub.Items[12] is TJSONArray then
    begin
      Fr := TJSONArray(Sub.Items[12]);
      X.SP := Fr.Count;
      SetLength(X.Stack, Max(64, Fr.Count * 2));
      for L := 0 to High(X.Stack) do X.Stack[L] := 0;
      for L := 0 to Fr.Count - 1 do X.Stack[L] := Fr.Integers[L];
    end;
    if Sub.Items[13] is TJSONArray then
    begin
      Fr := TJSONArray(Sub.Items[13]);
      SetLength(X.Frames, Fr.Count div 3);
      for L := 0 to High(X.Frames) do
      begin
        X.Frames[L].ReturnPC := Fr.Integers[L * 3];
        X.Frames[L].LocalsBase := Fr.Integers[L * 3 + 1];
        X.Frames[L].Discard := Fr.Booleans[L * 3 + 2];
        X.Frames[L].ReturnModule := X.ScriptModule;
      end;
    end;
    if (Sub.Count >= 17) and (Sub.Items[16] is TJSONArray) then
    begin
      Fr := TJSONArray(Sub.Items[16]);
      for L := 0 to Min(High(X.Frames), Fr.Count - 1) do
        X.Frames[L].ReturnModule := EnsureRange(Fr.Integers[L], 0, FMods.Count - 1);
    end;
    X.LocalsBase := EnsureRange(X.LocalsBase, 0, X.SP);
    FInstances.Add(X);
  end;
end;

end.
