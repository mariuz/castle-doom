{ ACS, the script language of Hexen and ZDoom maps: a map's BEHAVIOR lump
  holds the compiled p-code (ACC's output) of its scripts. TAcsModule
  reads the three lump formats (Hexen's "ACS\0", ZDoom's "ACSE" with
  32-bit p-codes and "ACSe" with byte p-codes, also when hidden behind an
  "ACS\0" header the way ACC writes them): the scripts, functions,
  strings and map variables. TAcsVM runs the scripts the world starts
  (open scripts at the level start, ACS_Execute lines...), a tic at a
  time like ZDoom's: each runs until it delays, waits for a sector, for
  another script, or ends.

  What a script does to the world goes through TAcsHost (the world's
  side): line specials (Hexen's actions, which the world translates like
  a UDMF line's), prints, sector and line changes, queries of the player
  and the actors. P-codes the VM does not know stop their script (the
  log says which); known ones that need features the game lacks
  (inventory by class names, HUD fonts, fades...) are skipped with their
  arguments, logged once each. No exceptions are raised: the web build
  cannot catch them.

  The p-code numbers come from ACC's pcode.h (doomacs_pcodes.inc,
  generated by tools/make_acs_pcodes.py). }
unit DoomAcs;

{$Q-}{$R-}

interface

uses SysUtils, Classes, Contnrs, fpjson;

{$I doomacs_pcodes.inc}

const
  AcsMapVarCount = 128;
  AcsWorldVarCount = 256;
  AcsGlobalVarCount = 64;
  { Hexen's script variables; ZDoom's SVCT chunk can ask for more. }
  AcsDefaultScriptVars = 20;
  AcsMaxStack = 4096;
  { Instructions a script may run in one tic before it is stopped. }
  AcsRunawayLimit = 500000;
  { Strings made by SAVESTRING are numbered from here. }
  AcsDynamicStringBase = 1000000;

  { Script types (the number's thousands in Hexen's format). }
  AcsClosed = 0;
  AcsOpen = 1;
  AcsRespawn = 2;
  AcsDeath = 3;
  AcsEnter = 4;

type
  TAcsFormat = (afOld, afEnhanced, afLittleEnhanced);
  TAcsArgs = array [0..4] of Integer;

  TAcsScriptInfo = record
    Number, ScriptType, Address, ArgCount, VarCount: Integer;
  end;

  TAcsFunction = record
    ArgCount, LocalCount, Address: Integer;
    HasReturn: Boolean;
  end;

  { A line special (or a texture change) with constant arguments found in
    the code, for the world to know which sectors scripts can move. }
  TAcsConstCall = record
    { The action, or AcsCallChangeFloor / Ceiling / SetLineTexture. }
    Special: Integer;
    Args: TAcsArgs;
  end;

  TAcsConstCalls = array of TAcsConstCall;

const
  AcsCallChangeFloor = -1;
  AcsCallChangeCeiling = -2;
  AcsCallSetLineTexture = -3;

type
  TAcsModule = class
  strict private
    FChunks, FChunksEnd: Integer;
    function Int(const Ofs: Integer): Integer;
    function CString(const Ofs: Integer): String;
    function FindChunk(const Id: String; const After: Integer = -1): Integer;
    function ChunkSize(const Chunk: Integer): Integer;
    procedure LoadOld(const DirOfs: Integer);
    procedure LoadChunks;
    procedure ReadStringTable(const Chunk: Integer; const Encrypted: Boolean);
  public
    Data: TBytes;
    Format: TAcsFormat;
    Scripts: array of TAcsScriptInfo;
    Functions: array of TAcsFunction;
    Strings: array of String;
    MapVarInit: array [0..AcsMapVarCount - 1] of Integer;
    { Map arrays: ARAY's (map variable, size) pairs and AINI's values. }
    ArrayVar, ArraySize: array of Integer;
    ArrayInit: array of array of Integer;
    { Not empty when the lump could not be read. }
    Error: String;
    constructor Create(const AData: TBytes);
    function FormatName: String;
    function FindScript(const Number: Integer): Integer;
    { The p-code reader of this format at Ofs (moved past what it read). }
    function ReadCode(var Ofs: Integer): Integer;
    function ReadByte(var Ofs: Integer): Integer;
    function ReadShort(var Ofs: Integer): Integer;
    function ReadWord(var Ofs: Integer): Integer;
    function RawByte(var Ofs: Integer): Integer;
    { Every line special with constant arguments the scripts and
      functions can reach. }
    function ConstCalls: TAcsConstCalls;
  end;

  TAcsState = (asRunning, asSuspended, asDelayed, asTagWait, asScriptWaitPre, asScriptWait, asDone);
  TAcsActivator = (aaWorld, aaPlayer, aaMonster);
  TAcsPrintKind = (apPrint, apBold, apHud, apLog);

  TAcsFrame = record
    ReturnPC, LocalsBase: Integer;
    Discard: Boolean;
  end;

  { A running script. }
  TAcsInstance = class
  public
    Script: Integer;
    Number: Integer;
    PC: Integer;
    State: TAcsState;
    StateData: Integer;
    Stack: array of Integer;
    SP, LocalsBase: Integer;
    Frames: array of TAcsFrame;
    Activator: TAcsActivator;
    ActivatorTid: Integer;
    Line: Integer;
    BackSide: Boolean;
    PrintText: String;
    OptStart: Integer;
    ResultValue: Integer;
  end;

  TAcsVM = class;

  { The world's side of the scripts; the defaults do nothing. }
  TAcsHost = class
  public
    function Random(const N: Integer): Integer; virtual;
    { Hexen's action Special (not one of the ACS_* ones, which the VM
      runs itself); the result for LSPEC5RESULT. }
    function LineSpecial(const Inst: TAcsInstance; const Special: Integer; const Args: TAcsArgs): Integer; virtual;
    procedure Print(const Inst: TAcsInstance; const Text: String; const Kind: TAcsPrintKind); virtual;
    { A sector with this tag moves. }
    function TagBusy(const Tag: Integer): Boolean; virtual;
    { Live things of a type (ZDoom's spawn number, 0 any) with a thing id
      (0 any). }
    function ThingCount(const SpawnNum, Tid: Integer): Integer; virtual;
    function ThingCountName(const Name: String; const Tid: Integer): Integer; virtual;
    procedure ChangeFlat(const Tag: Integer; const Name: String; const Ceiling: Boolean); virtual;
    procedure ClearLineSpecial(const Line: Integer); virtual;
    procedure SetLineTexture(const LineId, Side, Position: Integer; const Name: String); virtual;
    procedure SetLineBlocking(const LineId, Mode: Integer); virtual;
    procedure SetLineMonsterBlocking(const LineId: Integer; const Block: Boolean); virtual;
    procedure SetLineSpecial(const LineId, Special: Integer; const Args: TAcsArgs); virtual;
    procedure SetMusic(const Name: String); virtual;
    { A sound by name: at the activator line's front sector (Tag -1), the
      things with that tid, or everywhere (Tag -2). }
    procedure PlaySound(const Inst: TAcsInstance; const Name: String; const Volume, Where: Integer); virtual;
    function GameSkill: Integer; virtual;
    function LevelTime: Integer; virtual;
    function PlayerHealth: Integer; virtual;
    function PlayerArmor: Integer; virtual;
    { The PLAYERBLUESKULL.. PLAYERSILVERCARD p-codes, 0..12. }
    function PlayerHasKey(const Index: Integer): Boolean; virtual;
    { The actor (tid 0: the activator) as fixed point: 0 x, 1 y, 2 z,
      3 angle (a turn is 1.0), 4 floor height, 5 ceiling height; 6 its
      sector's light. }
    function ActorValue(const Inst: TAcsInstance; const Tid, What: Integer): Integer; virtual;
    { The first sector with Tag: 0 floor, 1 ceiling (fixed point), 2 light. }
    function SectorValue(const Tag, What: Integer): Integer; virtual;
    function Localize(const Name: String): String; virtual;
    { ACS_Execute's map argument names this map (0 always does). }
    function ThisMap(const N: Integer): Boolean; virtual;
  end;

  { World and global variables (and their arrays): they outlive a map. }
  TAcsGlobals = class
  public
    WorldVars: array [0..AcsWorldVarCount - 1] of Integer;
    GlobalVars: array [0..AcsGlobalVarCount - 1] of Integer;
    { Sparse arrays: (array * 2^32 + index, value) pairs, sorted. }
    ArrayKeys: array of Int64;
    ArrayValues: array of Integer;
    procedure Clear;
    { Array A of the world (0..255) or global (256 + 0..63) ones. }
    function GetArray(const A, Index: Integer): Integer;
    procedure SetArray(const A, Index, Value: Integer);
    function SaveState: TJSONObject;
    procedure LoadState(const J: TJSONObject);
  end;

  TAcsVM = class
  strict private
    FModule: TAcsModule;
    FHost: TAcsHost;
    FGlobals: TAcsGlobals;
    FInstances: TObjectList;
    FMapVars: array [0..AcsMapVarCount - 1] of Integer;
    FMapArrays: array of array of Integer;
    FDynStrings: array of String;
    FLogged: TStringList;
    FStarted: Integer;
    function Inst(const I: Integer): TAcsInstance;
    procedure Run(const I: TAcsInstance);
    function StringOf(const Index: Integer): String;
    procedure Stop(const I: TAcsInstance; const Why: String);
    procedure LogOnce(const What: String);
    function ActionSpecial(const I: TAcsInstance; const Special: Integer; const Args: TAcsArgs;
      out Value: Integer): Boolean;
  public
    constructor Create(const AModule: TAcsModule; const AHost: TAcsHost; const AGlobals: TAcsGlobals);
    destructor Destroy; override;
    { Start script Number (Always: another copy even when one runs; else
      a suspended one resumes and a running one is left alone). }
    function StartScript(const Number: Integer; const Args: array of Integer; const Activator: TAcsActivator;
      const Line: Integer; const BackSide, Always: Boolean): TAcsInstance;
    { The open (and enter) scripts at the level's start. }
    procedure StartLevel;
    { Every script of a type (AcsDeath...). }
    procedure StartType(const ScriptType: Integer; const Activator: TAcsActivator);
    procedure TerminateScript(const Number: Integer);
    procedure SuspendScript(const Number: Integer);
    function Running(const Number: Integer): Boolean;
    procedure Tic;
    function InstanceCount: Integer;
    function MapVar(const Index: Integer): Integer;
    function SaveState: TJSONObject;
    procedure LoadState(const J: TJSONObject);
    { Scripts started since the level began (for the log and tests). }
    property Started: Integer read FStarted;
    property Module: TAcsModule read FModule;
  end;

function AcsScriptTypeName(const ScriptType: Integer): String;
{ ZDoom's escapes in ACS strings: \n, \\, \", colour codes (\cX, \c[Name]) dropped. }
function AcsUnescape(const S: String): String;
function AcsPcodeName(const Op: Integer): String;

implementation

uses Math, CastleLog;

function AcsScriptTypeName(const ScriptType: Integer): String;
begin
  case ScriptType of
    AcsClosed: Result := 'closed';
    AcsOpen: Result := 'open';
    AcsRespawn: Result := 'respawn';
    AcsDeath: Result := 'death';
    AcsEnter: Result := 'enter';
    else Result := 'type ' + IntToStr(ScriptType);
  end;
end;

function AcsPcodeName(const Op: Integer): String;
begin
  if (Op >= 0) and (Op < PcdCount) then
    Result := AcsPcodeNames[Op]
  else
    Result := 'p-code ' + IntToStr(Op);
end;

function AcsUnescape(const S: String): String;
var
  I: Integer;
begin
  Result := '';
  I := 1;
  while I <= Length(S) do
  begin
    if (S[I] = '\') and (I < Length(S)) then
    begin
      Inc(I);
      case S[I] of
        'n': Result := Result + #10;
        't': Result := Result + ' ';
        'c', 'C':
          begin
            { A colour: one letter or a [name]. }
            if (I < Length(S)) and (S[I + 1] = '[') then
            begin
              while (I <= Length(S)) and (S[I] <> ']') do Inc(I);
            end else
              Inc(I);
          end;
        else Result := Result + S[I];
      end;
      Inc(I);
    end else
    begin
      Result := Result + S[I];
      Inc(I);
    end;
  end;
end;

function Wrap(const V: Int64): Integer; inline;
begin
  Result := Integer(Cardinal(V and $FFFFFFFF));
end;

{ TAcsModule ---------------------------------------------------------------- }

constructor TAcsModule.Create(const AData: TBytes);
var
  DirOfs, Pretag, I: Integer;
begin
  inherited Create;
  Data := AData;
  for I := 0 to AcsMapVarCount - 1 do MapVarInit[I] := 0;
  if (Length(Data) < 8) or (Data[0] <> Ord('A')) or (Data[1] <> Ord('C')) or (Data[2] <> Ord('S')) then
  begin
    Error := 'not an ACS lump';
    Exit;
  end;
  case Data[3] of
    0: Format := afOld;
    Ord('E'): Format := afEnhanced;
    Ord('e'): Format := afLittleEnhanced;
    else
      begin
        Error := 'unknown ACS format';
        Exit;
      end;
  end;
  if Format = afOld then
  begin
    DirOfs := Int(4);
    if (DirOfs < 8) or (DirOfs + 4 > Length(Data)) then
    begin
      Error := 'bad script directory';
      Exit;
    end;
    { ACC hides the ACSE / ACSe chunks before the old directory. }
    Pretag := 0;
    if DirOfs >= 24 then Pretag := Int(DirOfs - 4);
    if (Pretag = $45534341) or (Pretag = $65534341) then
    begin
      if Pretag = $65534341 then Format := afLittleEnhanced else Format := afEnhanced;
      FChunks := Int(DirOfs - 8);
      FChunksEnd := DirOfs - 8;
      LoadChunks;
    end else
      LoadOld(DirOfs);
  end else
  begin
    FChunks := Int(4);
    FChunksEnd := Length(Data);
    LoadChunks;
  end;
end;

function TAcsModule.FormatName: String;
begin
  case Format of
    afOld: Result := 'Hexen';
    afEnhanced: Result := 'ACSE';
    else Result := 'ACSe';
  end;
end;

function TAcsModule.Int(const Ofs: Integer): Integer;
begin
  if (Ofs < 0) or (Ofs + 4 > Length(Data)) then Exit(0);
  Result := Integer(Cardinal(Data[Ofs]) or (Cardinal(Data[Ofs + 1]) shl 8) or (Cardinal(Data[Ofs + 2]) shl 16) or
    (Cardinal(Data[Ofs + 3]) shl 24));
end;

function TAcsModule.CString(const Ofs: Integer): String;
var
  I: Integer;
begin
  Result := '';
  if Ofs < 0 then Exit;
  I := Ofs;
  while (I < Length(Data)) and (Data[I] <> 0) do
  begin
    Result := Result + Chr(Data[I]);
    Inc(I);
  end;
end;

function TAcsModule.FindChunk(const Id: String; const After: Integer): Integer;
var
  P: Integer;
begin
  if After >= 0 then P := After + 8 + ChunkSize(After) else P := FChunks;
  while (P >= 0) and (P + 8 <= FChunksEnd) do
  begin
    if (Chr(Data[P]) = Id[1]) and (Chr(Data[P + 1]) = Id[2]) and (Chr(Data[P + 2]) = Id[3]) and
       (Chr(Data[P + 3]) = Id[4]) then
      Exit(P);
    if Int(P + 4) < 0 then Break;
    P := P + 8 + Int(P + 4);
  end;
  Result := -1;
end;

function TAcsModule.ChunkSize(const Chunk: Integer): Integer;
begin
  Result := Max(0, Int(Chunk + 4));
end;

procedure TAcsModule.LoadOld(const DirOfs: Integer);
var
  N, I, P, Num: Integer;
begin
  N := Int(DirOfs);
  if (N < 0) or (DirOfs + 4 + N * 12 > Length(Data)) then
  begin
    Error := 'bad script directory';
    Exit;
  end;
  SetLength(Scripts, N);
  for I := 0 to N - 1 do
  begin
    P := DirOfs + 4 + I * 12;
    Num := Int(P);
    Scripts[I].Number := Num mod 1000;
    Scripts[I].ScriptType := Num div 1000;
    Scripts[I].Address := Int(P + 4);
    Scripts[I].ArgCount := Int(P + 8);
    Scripts[I].VarCount := Max(AcsDefaultScriptVars, Scripts[I].ArgCount);
  end;
  P := DirOfs + 4 + N * 12;
  N := Int(P);
  if (N < 0) or (P + 4 + N * 4 > Length(Data)) then N := 0;
  SetLength(Strings, N);
  for I := 0 to N - 1 do
    Strings[I] := AcsUnescape(CString(Int(P + 4 + I * 4)));
end;

procedure TAcsModule.ReadStringTable(const Chunk: Integer; const Encrypted: Boolean);
var
  D, N, I, Ofs, J, Key: Integer;
  S: String;
  B: Byte;
begin
  D := Chunk + 8;
  N := Int(D + 4);
  if (N < 0) or (D + 12 + N * 4 > Chunk + 8 + ChunkSize(Chunk)) then Exit;
  SetLength(Strings, N);
  for I := 0 to N - 1 do
  begin
    Ofs := Int(D + 12 + I * 4);
    if not Encrypted then
    begin
      Strings[I] := AcsUnescape(CString(D + Ofs));
      Continue;
    end;
    { STRE: each byte xor (offset * 157135 + its index / 2). }
    Key := Byte(Ofs * 157135);
    S := '';
    J := 0;
    while D + Ofs + J < Length(Data) do
    begin
      B := Data[D + Ofs + J] xor Byte(Key + (J shr 1));
      if B = 0 then Break;
      S := S + Chr(B);
      Inc(J);
    end;
    Strings[I] := AcsUnescape(S);
  end;
end;

procedure TAcsModule.LoadChunks;
var
  C, N, I, P, Size, First, Num, J: Integer;
  Old8: Boolean;
begin
  { Scripts: 12-byte entries, or 8 when the lump starts "ACS\0". }
  C := FindChunk('SPTR');
  if C >= 0 then
  begin
    Old8 := Data[3] = 0;
    Size := ChunkSize(C);
    if Old8 then N := Size div 8 else N := Size div 12;
    SetLength(Scripts, N);
    for I := 0 to N - 1 do
    begin
      if Old8 then
      begin
        P := C + 8 + I * 8;
        Scripts[I].Number := SmallInt(Data[P] or (Data[P + 1] shl 8));
        Scripts[I].ScriptType := Data[P + 2];
        Scripts[I].ArgCount := Data[P + 3];
        Scripts[I].Address := Int(P + 4);
      end else
      begin
        P := C + 8 + I * 12;
        Scripts[I].Number := SmallInt(Data[P] or (Data[P + 1] shl 8));
        Scripts[I].ScriptType := Data[P + 2] or (Data[P + 3] shl 8);
        Scripts[I].Address := Int(P + 4);
        Scripts[I].ArgCount := Int(P + 8);
      end;
      Scripts[I].VarCount := Max(AcsDefaultScriptVars, Scripts[I].ArgCount);
    end;
  end;
  { Variable counts above Hexen's 20. }
  C := FindChunk('SVCT');
  if C >= 0 then
    for I := 0 to ChunkSize(C) div 4 - 1 do
    begin
      P := C + 8 + I * 4;
      Num := SmallInt(Data[P] or (Data[P + 1] shl 8));
      J := FindScript(Num);
      if J >= 0 then
        Scripts[J].VarCount := Max(Scripts[J].ArgCount, Data[P + 2] or (Data[P + 3] shl 8));
    end;
  C := FindChunk('STRL');
  if C >= 0 then
    ReadStringTable(C, false)
  else
  begin
    C := FindChunk('STRE');
    if C >= 0 then ReadStringTable(C, true);
  end;
  C := FindChunk('FUNC');
  if C >= 0 then
  begin
    N := ChunkSize(C) div 8;
    SetLength(Functions, N);
    for I := 0 to N - 1 do
    begin
      P := C + 8 + I * 8;
      Functions[I].ArgCount := Data[P];
      Functions[I].LocalCount := Data[P + 1];
      Functions[I].HasReturn := Data[P + 2] <> 0;
      Functions[I].Address := Int(P + 4);
    end;
  end;
  C := FindChunk('MINI');
  while C >= 0 do
  begin
    First := Int(C + 8);
    for I := 0 to ChunkSize(C) div 4 - 2 do
      if (First + I >= 0) and (First + I < AcsMapVarCount) then
        MapVarInit[First + I] := Int(C + 12 + I * 4);
    C := FindChunk('MINI', C);
  end;
  C := FindChunk('ARAY');
  if C >= 0 then
  begin
    N := ChunkSize(C) div 8;
    SetLength(ArrayVar, N);
    SetLength(ArraySize, N);
    SetLength(ArrayInit, N);
    for I := 0 to N - 1 do
    begin
      ArrayVar[I] := Int(C + 8 + I * 8);
      ArraySize[I] := Max(0, Min(65536, Int(C + 12 + I * 8)));
    end;
  end;
  C := FindChunk('AINI');
  while C >= 0 do
  begin
    Num := Int(C + 8);
    for I := 0 to High(ArrayVar) do
      if ArrayVar[I] = Num then
      begin
        N := Min(ArraySize[I], ChunkSize(C) div 4 - 1);
        SetLength(ArrayInit[I], N);
        for J := 0 to N - 1 do
          ArrayInit[I][J] := Int(C + 12 + J * 4);
      end;
    C := FindChunk('AINI', C);
  end;
end;

function TAcsModule.FindScript(const Number: Integer): Integer;
var
  I: Integer;
begin
  for I := 0 to High(Scripts) do
    if Scripts[I].Number = Number then Exit(I);
  Result := -1;
end;

function TAcsModule.RawByte(var Ofs: Integer): Integer;
begin
  if (Ofs >= 0) and (Ofs < Length(Data)) then Result := Data[Ofs] else Result := 0;
  Inc(Ofs);
end;

function TAcsModule.ReadWord(var Ofs: Integer): Integer;
begin
  Result := Int(Ofs);
  Inc(Ofs, 4);
end;

function TAcsModule.ReadByte(var Ofs: Integer): Integer;
begin
  if Format = afLittleEnhanced then Result := RawByte(Ofs) else Result := ReadWord(Ofs);
end;

function TAcsModule.ReadShort(var Ofs: Integer): Integer;
var
  Lo: Integer;
begin
  if Format = afLittleEnhanced then
  begin
    Lo := RawByte(Ofs);
    Result := SmallInt(Lo or (RawByte(Ofs) shl 8));
  end else
    Result := ReadWord(Ofs);
end;

function TAcsModule.ReadCode(var Ofs: Integer): Integer;
begin
  if Format = afLittleEnhanced then
  begin
    Result := RawByte(Ofs);
    if Result >= 240 then
      Result := 240 + ((Result - 240) shl 8) + RawByte(Ofs);
  end else
    Result := ReadWord(Ofs);
end;

function TAcsModule.ConstCalls: TAcsConstCalls;
var
  Visited: array of Boolean;
  Work: array of Integer;
  WorkCount, Count: Integer;
  Calls: TAcsConstCalls;
  Consts: array [0..7] of Integer;
  ConstCount: Integer;

  procedure Push(const Ofs: Integer);
  begin
    if (Ofs < 0) or (Ofs >= Length(Data)) or Visited[Ofs] then Exit;
    if WorkCount = Length(Work) then SetLength(Work, WorkCount * 2 + 16);
    Work[WorkCount] := Ofs;
    Inc(WorkCount);
  end;

  procedure PushConst(const V: Integer);
  var
    K: Integer;
  begin
    if ConstCount = Length(Consts) then
    begin
      for K := 1 to High(Consts) do Consts[K - 1] := Consts[K];
      Dec(ConstCount);
    end;
    Consts[ConstCount] := V;
    Inc(ConstCount);
  end;

  procedure AddCall(const Special: Integer; const Args: TAcsArgs);
  begin
    if Count = Length(Calls) then SetLength(Calls, Count * 2 + 8);
    Calls[Count].Special := Special;
    Calls[Count].Args := Args;
    Inc(Count);
  end;

  { A call taking N arguments from the stack, Arg0 being the first. }
  procedure StackCall(const Special, N: Integer);
  var
    A: TAcsArgs;
    K: Integer;
  begin
    if ConstCount < N then Exit;
    A := Default(TAcsArgs);
    for K := 0 to Min(N, 5) - 1 do
      A[K] := Consts[ConstCount - N + K];
    AddCall(Special, A);
  end;

  procedure Walk(Ofs: Integer);
  var
    Op, N, K, Special, Start: Integer;
    A: TAcsArgs;
    Keep: Boolean;
  begin
    ConstCount := 0;
    while (Ofs >= 0) and (Ofs < Length(Data)) and not Visited[Ofs] do
    begin
      Start := Ofs;
      Visited[Start] := true;
      Op := ReadCode(Ofs);
      Keep := false;
      A := Default(TAcsArgs);
      case Op of
        PcdTerminate, PcdRestart, PcdReturnvoid, PcdReturnval, PcdGotostack: Exit;
        PcdPushnumber:
          begin
            PushConst(ReadWord(Ofs));
            Keep := true;
          end;
        PcdPushbyte:
          begin
            PushConst(RawByte(Ofs));
            Keep := true;
          end;
        PcdPush2bytes..PcdPush5bytes:
          begin
            for K := 1 to Op - PcdPush2bytes + 2 do PushConst(RawByte(Ofs));
            Keep := true;
          end;
        PcdPushbytes:
          begin
            N := RawByte(Ofs);
            for K := 1 to N do PushConst(RawByte(Ofs));
            Keep := true;
          end;
        PcdLspec1..PcdLspec5:
          StackCall(ReadByte(Ofs), Op - PcdLspec1 + 1);
        PcdLspec1direct..PcdLspec5direct:
          begin
            Special := ReadByte(Ofs);
            for K := 0 to Op - PcdLspec1direct do A[K] := ReadWord(Ofs);
            AddCall(Special, A);
          end;
        PcdLspec1directb..PcdLspec5directb:
          begin
            Special := RawByte(Ofs);
            for K := 0 to Op - PcdLspec1directb do A[K] := RawByte(Ofs);
            AddCall(Special, A);
          end;
        PcdLspec5result: StackCall(ReadByte(Ofs), 5);
        PcdLspec5ex, PcdLspec5exresult: StackCall(ReadWord(Ofs), 5);
        PcdChangefloor: StackCall(AcsCallChangeFloor, 2);
        PcdChangeceiling: StackCall(AcsCallChangeCeiling, 2);
        PcdChangefloordirect, PcdChangeceilingdirect:
          begin
            A[0] := ReadWord(Ofs);
            ReadWord(Ofs);
            if Op = PcdChangefloordirect then AddCall(AcsCallChangeFloor, A) else AddCall(AcsCallChangeCeiling, A);
          end;
        PcdSetlinetexture: StackCall(AcsCallSetLineTexture, 4);
        PcdGoto:
          begin
            Ofs := ReadWord(Ofs);
            ConstCount := 0;
            Continue;
          end;
        PcdIfgoto, PcdIfnotgoto:
          Push(ReadWord(Ofs));
        PcdCasegoto:
          begin
            ReadWord(Ofs);
            Push(ReadWord(Ofs));
          end;
        PcdCasegotosorted:
          begin
            Ofs := (Ofs + 3) and not 3;
            N := ReadWord(Ofs);
            if (N < 0) or (N > Length(Data) div 8) then Exit;
            for K := 1 to N do
            begin
              ReadWord(Ofs);
              Push(ReadWord(Ofs));
            end;
          end;
        { One inline argument the size of NEXTBYTE. }
        PcdAssignscriptvar..PcdDecworldvar, PcdAssignglobalvar..PcdDecglobalvar,
        PcdPushmaparray..PcdDecmaparray, PcdPushworldarray..PcdDecglobalarray,
        PcdAndscriptvar..PcdRsglobalarray, PcdAssignscriptarray..PcdRsscriptarray,
        PcdCall, PcdCalldiscard, PcdPushfunction:
          ReadByte(Ofs);
        PcdCallfunc:
          begin
            ReadByte(Ofs);
            ReadShort(Ofs);
          end;
        { Inline 32-bit arguments. }
        PcdDelaydirect, PcdTagwaitdirect, PcdPolywaitdirect, PcdScriptwaitdirect, PcdSetgravitydirect,
        PcdSetaircontroldirect, PcdCheckinventorydirect, PcdSetstyledirect, PcdSetfontdirect:
          ReadWord(Ofs);
        PcdRandomdirect, PcdThingcountdirect, PcdGiveinventorydirect, PcdTakeinventorydirect:
          Inc(Ofs, 8);
        PcdConsolecommanddirect, PcdSetmusicdirect, PcdLocalsetmusicdirect: Inc(Ofs, 12);
        PcdSpawnspotdirect: Inc(Ofs, 16);
        PcdSpawndirect: Inc(Ofs, 24);
        PcdDelaydirectb: Inc(Ofs);
        PcdRandomdirectb: Inc(Ofs, 2);
      end;
      if not Keep then ConstCount := 0;
    end;
  end;

var
  I: Integer;
begin
  Count := 0;
  SetLength(Calls, 0);
  SetLength(Visited, Length(Data));
  WorkCount := 0;
  for I := 0 to High(Scripts) do Push(Scripts[I].Address);
  for I := 0 to High(Functions) do Push(Functions[I].Address);
  while WorkCount > 0 do
  begin
    Dec(WorkCount);
    Walk(Work[WorkCount]);
  end;
  SetLength(Calls, Count);
  Result := Calls;
end;

