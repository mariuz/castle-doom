        end;
      PcdPushfunction: Push(M.ReadByte(I.PC) or (I.Module shl 16));
      PcdReturnvoid: ReturnFrom(0);
      PcdReturnval: ReturnFrom(Pop);
      PcdGotostack: Jump(Pop);
      PcdCallfunc:
        begin
          N := M.ReadByte(I.PC);
          A := M.ReadShort(I.PC);
