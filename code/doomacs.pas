{ TAcsGlobals --------------------------------------------------------------- }

procedure TAcsGlobals.Clear;
var
  I: Integer;
begin
  for I := 0 to High(WorldVars) do WorldVars[I] := 0;
  for I := 0 to High(GlobalVars) do GlobalVars[I] := 0;
  SetLength(ArrayKeys, 0);
  SetLength(ArrayValues, 0);
end;

function FindKey(const Keys: array of Int64; const Key: Int64; out Pos: Integer): Boolean;
var
  Lo, Hi, Mid: Integer;
begin
  Lo := 0;
  Hi := High(Keys);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if Keys[Mid] = Key then
    begin
      Pos := Mid;
      Exit(true);
    end;
    if Keys[Mid] < Key then Lo := Mid + 1 else Hi := Mid - 1;
  end;
  Pos := Lo;
  Result := false;
end;

function TAcsGlobals.GetArray(const A, Index: Integer): Integer;
var
  P: Integer;
begin
  if FindKey(ArrayKeys, (Int64(A) shl 32) or Cardinal(Index), P) then
    Result := ArrayValues[P]
  else
    Result := 0;
end;

procedure TAcsGlobals.SetArray(const A, Index, Value: Integer);
var
  P, N, K: Integer;
  Key: Int64;
begin
  Key := (Int64(A) shl 32) or Cardinal(Index);
  if FindKey(ArrayKeys, Key, P) then
  begin
    ArrayValues[P] := Value;
    Exit;
  end;
  N := Length(ArrayKeys);
  SetLength(ArrayKeys, N + 1);
  SetLength(ArrayValues, N + 1);
  for K := N downto P + 1 do
  begin
    ArrayKeys[K] := ArrayKeys[K - 1];
    ArrayValues[K] := ArrayValues[K - 1];
  end;
  ArrayKeys[P] := Key;
  ArrayValues[P] := Value;
end;

function IntsToJson(const Values: array of Integer): TJSONArray;
var
  I, Last: Integer;
begin
  Result := TJSONArray.Create;
  { Trailing zeros are left out. }
  Last := High(Values);
  while (Last >= 0) and (Values[Last] = 0) do Dec(Last);
  for I := 0 to Last do Result.Add(Values[I]);
end;

procedure IntsFromJson(const Arr: TJSONData; var Values: array of Integer);
var
  I: Integer;
begin
  for I := 0 to High(Values) do Values[I] := 0;
  if not (Arr is TJSONArray) then Exit;
  for I := 0 to Min(High(Values), TJSONArray(Arr).Count - 1) do
    if TJSONArray(Arr).Items[I].JSONType = jtNumber then
      Values[I] := TJSONArray(Arr).Items[I].AsInteger;
end;

function TAcsGlobals.SaveState: TJSONObject;
var
  Arr: TJSONArray;
  I: Integer;
begin
  Result := TJSONObject.Create;
  Result.Add('world', IntsToJson(WorldVars));
  Result.Add('global', IntsToJson(GlobalVars));
  Arr := TJSONArray.Create;
  for I := 0 to High(ArrayKeys) do
  begin
    Arr.Add(Integer(ArrayKeys[I] shr 32));
    Arr.Add(Integer(Cardinal(ArrayKeys[I] and $FFFFFFFF)));
    Arr.Add(ArrayValues[I]);
  end;
  Result.Add('arrays', Arr);
end;

procedure TAcsGlobals.LoadState(const J: TJSONObject);
var
  Arr: TJSONData;
  I: Integer;
begin
  Clear;
  if J = nil then Exit;
  IntsFromJson(J.Find('world'), WorldVars);
  IntsFromJson(J.Find('global'), GlobalVars);
  Arr := J.Find('arrays');
  if Arr is TJSONArray then
    for I := 0 to TJSONArray(Arr).Count div 3 - 1 do
      SetArray(TJSONArray(Arr).Integers[I * 3], TJSONArray(Arr).Integers[I * 3 + 1],
        TJSONArray(Arr).Integers[I * 3 + 2]);
end;

{ TAcsVM -------------------------------------------------------------------- }

constructor TAcsVM.Create(const AModule: TAcsModule; const AHost: TAcsHost; const AGlobals: TAcsGlobals);
var
  I, J: Integer;
begin
  inherited Create;
  FModule := AModule;
  FHost := AHost;
  FGlobals := AGlobals;
  FInstances := TObjectList.Create(true);
  FLogged := TStringList.Create;
  FLogged.Sorted := true;
  for I := 0 to AcsMapVarCount - 1 do FMapVars[I] := FModule.MapVarInit[I];
  { A map array's variable holds the array's number. }
  SetLength(FMapArrays, Length(FModule.ArrayVar));
  for I := 0 to High(FModule.ArrayVar) do
  begin
    SetLength(FMapArrays[I], FModule.ArraySize[I]);
    for J := 0 to FModule.ArraySize[I] - 1 do
      if J <= High(FModule.ArrayInit[I]) then
        FMapArrays[I][J] := FModule.ArrayInit[I][J]
      else
        FMapArrays[I][J] := 0;
    if (FModule.ArrayVar[I] >= 0) and (FModule.ArrayVar[I] < AcsMapVarCount) then
      FMapVars[FModule.ArrayVar[I]] := I;
  end;
end;

destructor TAcsVM.Destroy;
begin
  FreeAndNil(FInstances);
  FreeAndNil(FLogged);
  FreeAndNil(FModule);
  inherited;
end;

function TAcsVM.Inst(const I: Integer): TAcsInstance;
begin
  Result := TAcsInstance(FInstances[I]);
end;

function TAcsVM.InstanceCount: Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to FInstances.Count - 1 do
    if Inst(I).State <> asDone then Inc(Result);
end;

function TAcsVM.MapVar(const Index: Integer): Integer;
begin
  if (Index >= 0) and (Index < AcsMapVarCount) then Result := FMapVars[Index] else Result := 0;
end;

procedure TAcsVM.LogOnce(const What: String);
begin
  if FLogged.IndexOf(What) >= 0 then Exit;
  FLogged.Add(What);
  WritelnLog('Acs', '%s not supported, skipped', [What]);
end;

procedure TAcsVM.Stop(const I: TAcsInstance; const Why: String);
begin
  WritelnLog('Acs', 'script %d stopped: %s', [I.Number, Why]);
  I.State := asDone;
end;

function TAcsVM.StringOf(const Index: Integer): String;
var
  I: Integer;
begin
  I := Index and $FFFF;
  if Index >= AcsDynamicStringBase then
  begin
    I := Index - AcsDynamicStringBase;
    if I <= High(FDynStrings) then Exit(FDynStrings[I]);
    Exit('');
  end;
  if (I >= 0) and (I <= High(FModule.Strings)) then Result := FModule.Strings[I] else Result := '';
end;

function TAcsVM.Running(const Number: Integer): Boolean;
var
  I: Integer;
begin
  for I := 0 to FInstances.Count - 1 do
    if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then Exit(true);
  Result := false;
end;

function TAcsVM.StartScript(const Number: Integer; const Args: array of Integer; const Activator: TAcsActivator;
  const Line: Integer; const BackSide, Always: Boolean): TAcsInstance;
var
  S, I, K: Integer;
begin
  Result := nil;
  S := FModule.FindScript(Number);
  if S < 0 then
  begin
    WritelnLog('Acs', 'script %d not found', [Number]);
    Exit;
  end;
  if not Always then
    for I := 0 to FInstances.Count - 1 do
      if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then
      begin
        if Inst(I).State = asSuspended then
        begin
          Inst(I).State := asRunning;
          WritelnLog('Acs', 'script %d resumed', [Number]);
          Exit(Inst(I));
        end;
        Exit;
      end;
  Result := TAcsInstance.Create;
  Result.Script := S;
  Result.Number := Number;
  Result.PC := FModule.Scripts[S].Address;
  Result.State := asRunning;
  SetLength(Result.Stack, FModule.Scripts[S].VarCount + 64);
  for K := 0 to High(Result.Stack) do Result.Stack[K] := 0;
  for K := 0 to Min(High(Args), FModule.Scripts[S].ArgCount - 1) do
    Result.Stack[K] := Args[K];
  Result.LocalsBase := 0;
  Result.SP := FModule.Scripts[S].VarCount;
  Result.Activator := Activator;
  Result.Line := Line;
  Result.BackSide := BackSide;
  Result.OptStart := -1;
  FInstances.Add(Result);
  Inc(FStarted);
  WritelnLog('Acs', 'script %d (%s) started', [Number, AcsScriptTypeName(FModule.Scripts[S].ScriptType)]);
end;

procedure TAcsVM.StartType(const ScriptType: Integer; const Activator: TAcsActivator);
var
  I: Integer;
begin
  for I := 0 to High(FModule.Scripts) do
    if FModule.Scripts[I].ScriptType = ScriptType then
      StartScript(FModule.Scripts[I].Number, [], Activator, -1, false, true);
end;

procedure TAcsVM.StartLevel;
begin
  StartType(AcsOpen, aaWorld);
  StartType(AcsEnter, aaPlayer);
end;

procedure TAcsVM.TerminateScript(const Number: Integer);
var
  I: Integer;
begin
  for I := 0 to FInstances.Count - 1 do
    if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then
    begin
      Inst(I).State := asDone;
      WritelnLog('Acs', 'script %d terminated', [Number]);
    end;
end;

procedure TAcsVM.SuspendScript(const Number: Integer);
var
  I: Integer;
begin
  for I := 0 to FInstances.Count - 1 do
    if (Inst(I).Number = Number) and (Inst(I).State <> asDone) then
      Inst(I).State := asSuspended;
end;

procedure TAcsVM.Tic;
var
  I, N: Integer;
  X: TAcsInstance;
begin
  N := FInstances.Count;
  for I := 0 to N - 1 do
  begin
    X := Inst(I);
    case X.State of
      asDelayed:
        begin
          Dec(X.StateData);
          if X.StateData <= 0 then X.State := asRunning;
        end;
      asTagWait:
        if not FHost.TagBusy(X.StateData) then X.State := asRunning;
      asScriptWaitPre:
        if Running(X.StateData) then X.State := asScriptWait;
      asScriptWait:
        if not Running(X.StateData) then X.State := asRunning;
    end;
    if X.State = asRunning then
      Run(X);
  end;
  for I := FInstances.Count - 1 downto 0 do
    if Inst(I).State = asDone then
      FInstances.Delete(I);
end;

{ The ACS_* actions run here; the rest go to the host. }
function TAcsVM.ActionSpecial(const I: TAcsInstance; const Special: Integer; const Args: TAcsArgs;
  out Value: Integer): Boolean;
var
  X: TAcsInstance;
begin
  Value := 1;
  Result := true;
  case Special of
    80, 226:
      begin
        if not FHost.ThisMap(Args[1]) then
        begin
          LogOnce('ACS_Execute on another map');
          Exit(false);
        end;
        Result := StartScript(Args[0], [Args[2], Args[3], Args[4]], I.Activator, I.Line, I.BackSide,
          Special = 226) <> nil;
      end;
    84:
      begin
        X := StartScript(Args[0], [Args[1], Args[2], Args[3], Args[4]], I.Activator, I.Line, I.BackSide, true);
        Value := 0;
        if X <> nil then
        begin
          Run(X);
          Value := X.ResultValue;
        end;
      end;
    81: TerminateScript(Args[0]);
    82: SuspendScript(Args[0]);
    else
      Value := FHost.LineSpecial(I, Special, Args);
  end;
  if not Result then Value := 0;
end;

procedure TAcsVM.Run(const I: TAcsInstance);
type
  TVarKind = (vkScript, vkMap, vkWorld, vkGlobal, vkMapArray, vkWorldArray, vkGlobalArray);
  TVarOp = (voAssign, voPush, voAdd, voSub, voMul, voDiv, voMod, voInc, voDec, voAnd, voEor, voOr, voLs, voRs);
var
  M: TAcsModule;
  Op, Count, A, B, K, N, Special, Target: Integer;
  Args: TAcsArgs;
  Kind: TVarKind;
  VOp: TVarOp;
  LevelName: String;

  procedure Push(const V: Integer);
  begin
    if I.SP >= Length(I.Stack) then
    begin
      if Length(I.Stack) >= AcsMaxStack then
      begin
        Stop(I, 'stack overflow');
        Exit;
      end;
      SetLength(I.Stack, Length(I.Stack) * 2);
    end;
    I.Stack[I.SP] := V;
    Inc(I.SP);
  end;

  function Pop: Integer;
  begin
    if I.SP <= I.LocalsBase then Exit(0);
    Dec(I.SP);
    Result := I.Stack[I.SP];
  end;

  function Top: Integer;
  begin
    if I.SP <= I.LocalsBase then Exit(0);
    Result := I.Stack[I.SP - 1];
  end;

  procedure Drop(const N: Integer);
  begin
    I.SP := Max(I.LocalsBase, I.SP - N);
  end;

  procedure PopArgs(const N: Integer);
  var
    J: Integer;
  begin
    Args := Default(TAcsArgs);
    for J := N - 1 downto 0 do
      if J <= 4 then Args[J] := Pop else Pop;
  end;

  procedure DoSpecial(const Special: Integer; const PushResult: Boolean);
  var
    V: Integer;
  begin
    ActionSpecial(I, Special, Args, V);
    if PushResult then Push(V);
  end;

  { The skipped p-codes: N arguments popped, maybe a 0 pushed. }
  procedure Skip(const N: Integer; const PushZero: Boolean = false);
  begin
    LogOnce(AcsPcodeName(Op));
    Drop(N);
    if PushZero then Push(0);
  end;

  function Classify(const Op: Integer): Boolean;
  const
    Ops9: array [0..8] of TVarOp = (voAssign, voPush, voAdd, voSub, voMul, voDiv, voMod, voInc, voDec);
    ArrayOps9: array [0..8] of TVarOp = (voPush, voAssign, voAdd, voSub, voMul, voDiv, voMod, voInc, voDec);
    Bits: array [0..4] of TVarOp = (voAnd, voEor, voOr, voLs, voRs);
  begin
    Result := true;
    case Op of
      PcdAssignscriptvar..PcdDecworldvar:
        begin
          Kind := TVarKind((Op - PcdAssignscriptvar) mod 3);
          VOp := Ops9[(Op - PcdAssignscriptvar) div 3];
        end;
      PcdAssignglobalvar..PcdDecglobalvar:
        begin
          Kind := vkGlobal;
          VOp := Ops9[Op - PcdAssignglobalvar];
        end;
      PcdPushmaparray..PcdDecmaparray:
        begin
          Kind := vkMapArray;
          VOp := ArrayOps9[Op - PcdPushmaparray];
        end;
      PcdPushworldarray..PcdDecworldarray:
        begin
          Kind := vkWorldArray;
          VOp := ArrayOps9[Op - PcdPushworldarray];
        end;
      PcdPushglobalarray..PcdDecglobalarray:
        begin
          Kind := vkGlobalArray;
          VOp := ArrayOps9[Op - PcdPushglobalarray];
        end;
      PcdAndscriptvar..PcdRsglobalarray:
        begin
          Kind := TVarKind((Op - PcdAndscriptvar) mod 7);
          VOp := Bits[(Op - PcdAndscriptvar) div 7];
        end;
      else Result := false;
    end;
  end;

  { A variable op on Kind's variable Index. }
  procedure VarOp(const Index: Integer);
  var
    Elem, Value, Old, NewValue, ArrNum: Integer;
    Ok: Boolean;
  begin
    Elem := 0;
    Value := 0;
    if not (VOp in [voPush, voInc, voDec]) then Value := Pop;
    if Kind in [vkMapArray, vkWorldArray, vkGlobalArray] then Elem := Pop;
    Ok := true;
    ArrNum := 0;
    { The old value. }
    case Kind of
      vkScript:
        begin
          Ok := (Index >= 0) and (I.LocalsBase + Index < I.SP);
          if Ok then Old := I.Stack[I.LocalsBase + Index] else Old := 0;
        end;
      vkMap: begin Ok := (Index >= 0) and (Index < AcsMapVarCount); if Ok then Old := FMapVars[Index] else Old := 0; end;
      vkWorld: begin Ok := (Index >= 0) and (Index < AcsWorldVarCount); if Ok then Old := FGlobals.WorldVars[Index] else Old := 0; end;
      vkGlobal: begin Ok := (Index >= 0) and (Index < AcsGlobalVarCount); if Ok then Old := FGlobals.GlobalVars[Index] else Old := 0; end;
      vkMapArray:
        begin
          Ok := (Index >= 0) and (Index < AcsMapVarCount);
          if Ok then ArrNum := FMapVars[Index];
          Ok := Ok and (ArrNum >= 0) and (ArrNum <= High(FMapArrays)) and (Elem >= 0) and
            (Elem <= High(FMapArrays[ArrNum]));
          if Ok then Old := FMapArrays[ArrNum][Elem] else Old := 0;
        end;
      vkWorldArray: Old := FGlobals.GetArray(Index, Elem);
      else Old := FGlobals.GetArray(AcsWorldVarCount + Index, Elem);
    end;
    case VOp of
      voPush:
        begin
          Push(Old);
          Exit;
        end;
      voAssign: NewValue := Value;
      voAdd: NewValue := Wrap(Int64(Old) + Value);
      voSub: NewValue := Wrap(Int64(Old) - Value);
      voMul: NewValue := Wrap(Int64(Old) * Value);
      voDiv, voMod:
        begin
          if Value = 0 then
          begin
            Stop(I, 'division by zero');
            Exit;
          end;
          if VOp = voDiv then NewValue := Wrap(Int64(Old) div Value) else NewValue := Wrap(Int64(Old) mod Value);
        end;
      voInc: NewValue := Wrap(Int64(Old) + 1);
      voDec: NewValue := Wrap(Int64(Old) - 1);
      voAnd: NewValue := Old and Value;
      voEor: NewValue := Old xor Value;
      voOr: NewValue := Old or Value;
      voLs: NewValue := Wrap(Int64(Old) shl (Value and 31));
      else NewValue := SarLongint(Old, Value and 31);
    end;
    if not Ok then Exit;
    case Kind of
      vkScript: I.Stack[I.LocalsBase + Index] := NewValue;
      vkMap: FMapVars[Index] := NewValue;
      vkWorld: FGlobals.WorldVars[Index] := NewValue;
      vkGlobal: FGlobals.GlobalVars[Index] := NewValue;
      vkMapArray: FMapArrays[ArrNum][Elem] := NewValue;
      vkWorldArray: FGlobals.SetArray(Index, Elem, NewValue);
      else FGlobals.SetArray(AcsWorldVarCount + Index, Elem, NewValue);
    end;
  end;

  procedure Jump(const Ofs: Integer);
  begin
    I.PC := Ofs;
  end;

  procedure CallFunction(const F: Integer; const Discard: Boolean);
  var
    J, Fr: Integer;
  begin
    if (F < 0) or (F > High(M.Functions)) then
    begin
      Stop(I, SysUtils.Format('function %d not found', [F]));
      Exit;
    end;
    if Length(I.Frames) >= 1000 then
    begin
      Stop(I, 'functions nested too deep');
      Exit;
    end;
    Fr := Length(I.Frames);
    SetLength(I.Frames, Fr + 1);
    I.Frames[Fr].ReturnPC := I.PC;
    I.Frames[Fr].LocalsBase := I.LocalsBase;
    I.Frames[Fr].Discard := Discard;
    I.LocalsBase := Max(0, I.SP - M.Functions[F].ArgCount);
    for J := 1 to M.Functions[F].LocalCount do Push(0);
    I.PC := M.Functions[F].Address;
  end;

  procedure ReturnFrom(const Value: Integer);
  var
    Fr: Integer;
  begin
    Fr := High(I.Frames);
    if Fr < 0 then
    begin
      I.State := asDone;
      Exit;
    end;
    I.SP := I.LocalsBase;
    I.LocalsBase := I.Frames[Fr].LocalsBase;
    I.PC := I.Frames[Fr].ReturnPC;
    if not I.Frames[Fr].Discard then Push(Value);
    SetLength(I.Frames, Fr);
  end;

  procedure Print(const Kind: TAcsPrintKind);
  var
    S: String;
  begin
    S := I.PrintText;
    I.PrintText := '';
    FHost.Print(I, S, Kind);
  end;

  function BinaryText(V: Cardinal): String;
  begin
    Result := '';
    repeat
      Result := Chr(Ord('0') + (V and 1)) + Result;
      V := V shr 1;
    until V = 0;
  end;

  { The fixed point number V as text, like ZDoom's %g. }
  function FixedText(const V: Integer): String;
  begin
    Result := FloatToStr(V / 65536, DefaultFormatSettings);
    Result := StringReplace(Result, DefaultFormatSettings.DecimalSeparator, '.', []);
  end;

  procedure PrintArray(const ArrayKind: TVarKind; const Index, Offset: Integer);
  var
    J, C, ArrNum: Integer;
  begin
    J := Offset;
    while J - Offset < 4096 do
    begin
      case ArrayKind of
        vkMapArray:
          begin
            if (Index < 0) or (Index >= AcsMapVarCount) then Exit;
            ArrNum := FMapVars[Index];
            if (ArrNum < 0) or (ArrNum > High(FMapArrays)) or (J < 0) or (J > High(FMapArrays[ArrNum])) then Exit;
            C := FMapArrays[ArrNum][J];
          end;
        vkWorldArray: C := FGlobals.GetArray(Index, J);
        else C := FGlobals.GetArray(AcsWorldVarCount + Index, J);
      end;
      if C = 0 then Exit;
      I.PrintText := I.PrintText + Chr(C and 255);
      Inc(J);
    end;
  end;

begin
  M := FModule;
  Count := 0;
  while I.State = asRunning do
  begin
    Inc(Count);
    if Count > AcsRunawayLimit then
    begin
      Stop(I, 'runaway script (too many instructions in one tic)');
      Exit;
    end;
    if (I.PC < 0) or (I.PC >= Length(M.Data)) then
    begin
      Stop(I, 'jumped out of the code');
      Exit;
    end;
    Op := M.ReadCode(I.PC);
    if Classify(Op) then
    begin
      VarOp(M.ReadByte(I.PC));
      Continue;
    end;
    case Op of
      PcdNop: ;
      PcdTerminate: I.State := asDone;
      PcdSuspend: I.State := asSuspended;
      PcdRestart: I.PC := M.Scripts[I.Script].Address;
      PcdPushnumber: Push(M.ReadWord(I.PC));
      PcdPushbyte: Push(M.RawByte(I.PC));
      PcdPush2bytes..PcdPush5bytes:
        for K := 1 to Op - PcdPush2bytes + 2 do Push(M.RawByte(I.PC));
      PcdPushbytes:
        begin
          N := M.RawByte(I.PC);
          for K := 1 to N do Push(M.RawByte(I.PC));
        end;
      PcdLspec1..PcdLspec5:
        begin
          Special := M.ReadByte(I.PC);
          PopArgs(Op - PcdLspec1 + 1);
          DoSpecial(Special, false);
        end;
      PcdLspec1direct..PcdLspec5direct:
        begin
          Special := M.ReadByte(I.PC);
          Args := Default(TAcsArgs);
          for K := 0 to Op - PcdLspec1direct do Args[K] := M.ReadWord(I.PC);
          DoSpecial(Special, false);
        end;
      PcdLspec1directb..PcdLspec5directb:
        begin
          Special := M.RawByte(I.PC);
          Args := Default(TAcsArgs);
          for K := 0 to Op - PcdLspec1directb do Args[K] := M.RawByte(I.PC);
          DoSpecial(Special, false);
        end;
      PcdLspec5result:
        begin
          Special := M.ReadByte(I.PC);
          PopArgs(5);
          DoSpecial(Special, true);
        end;
      PcdLspec5ex, PcdLspec5exresult:
        begin
          Special := M.ReadWord(I.PC);
          PopArgs(5);
          DoSpecial(Special, Op = PcdLspec5exresult);
        end;
      PcdAdd: begin B := Pop; A := Pop; Push(Wrap(Int64(A) + B)); end;
      PcdSubtract: begin B := Pop; A := Pop; Push(Wrap(Int64(A) - B)); end;
      PcdMultiply: begin B := Pop; A := Pop; Push(Wrap(Int64(A) * B)); end;
      PcdDivide, PcdModulus:
        begin
          B := Pop;
          A := Pop;
          if B = 0 then
          begin
            Stop(I, 'division by zero');
            Exit;
          end;
          if Op = PcdDivide then Push(Wrap(Int64(A) div B)) else Push(Wrap(Int64(A) mod B));
        end;
      PcdEq: begin B := Pop; A := Pop; Push(Ord(A = B)); end;
      PcdNe: begin B := Pop; A := Pop; Push(Ord(A <> B)); end;
      PcdLt: begin B := Pop; A := Pop; Push(Ord(A < B)); end;
      PcdGt: begin B := Pop; A := Pop; Push(Ord(A > B)); end;
      PcdLe: begin B := Pop; A := Pop; Push(Ord(A <= B)); end;
      PcdGe: begin B := Pop; A := Pop; Push(Ord(A >= B)); end;
      PcdAndlogical: begin B := Pop; A := Pop; Push(Ord((A <> 0) and (B <> 0))); end;
      PcdOrlogical: begin B := Pop; A := Pop; Push(Ord((A <> 0) or (B <> 0))); end;
      PcdAndbitwise: begin B := Pop; A := Pop; Push(A and B); end;
      PcdOrbitwise: begin B := Pop; A := Pop; Push(A or B); end;
      PcdEorbitwise: begin B := Pop; A := Pop; Push(A xor B); end;
      PcdNegatelogical: Push(Ord(Pop = 0));
      PcdNegatebinary: Push(not Pop);
      PcdLshift: begin B := Pop; A := Pop; Push(Wrap(Int64(A) shl (B and 31))); end;
      PcdRshift: begin B := Pop; A := Pop; Push(SarLongint(A, B and 31)); end;
      PcdUnaryminus: Push(Wrap(-Int64(Pop)));
      PcdGoto: Jump(M.ReadWord(I.PC));
      PcdIfgoto:
        begin
          Target := M.ReadWord(I.PC);
          if Pop <> 0 then Jump(Target);
        end;
      PcdIfnotgoto:
        begin
          Target := M.ReadWord(I.PC);
          if Pop = 0 then Jump(Target);
        end;
      PcdCasegoto:
        begin
          A := M.ReadWord(I.PC);
          Target := M.ReadWord(I.PC);
          if Top = A then
          begin
            Drop(1);
            Jump(Target);
          end;
        end;
      PcdCasegotosorted:
        begin
          I.PC := (I.PC + 3) and not 3;
          N := M.ReadWord(I.PC);
          A := Top;
          Target := -1;
          for K := 0 to N - 1 do
          begin
            B := M.ReadWord(I.PC);
            if (B = A) and (Target < 0) then
              Target := M.ReadWord(I.PC)
            else
              M.ReadWord(I.PC);
          end;
          if Target >= 0 then
          begin
            Drop(1);
            Jump(Target);
          end;
        end;
      PcdDrop: Drop(1);
      PcdDup: Push(Top);
      PcdSwap:
        if I.SP - 2 >= I.LocalsBase then
        begin
          A := I.Stack[I.SP - 1];
          I.Stack[I.SP - 1] := I.Stack[I.SP - 2];
          I.Stack[I.SP - 2] := A;
        end;
      PcdDelay, PcdDelaydirect, PcdDelaydirectb:
        begin
          case Op of
            PcdDelay: A := Pop;
            PcdDelaydirect: A := M.ReadWord(I.PC);
            else A := M.RawByte(I.PC);
          end;
          if A > 0 then
          begin
            I.State := asDelayed;
            I.StateData := A;
          end;
        end;
      PcdRandom, PcdRandomdirect, PcdRandomdirectb:
        begin
          case Op of
            PcdRandom: begin B := Pop; A := Pop; end;
            PcdRandomdirect: begin A := M.ReadWord(I.PC); B := M.ReadWord(I.PC); end;
            else begin A := M.RawByte(I.PC); B := M.RawByte(I.PC); end;
          end;
          if B < A then
          begin
            K := A; A := B; B := K;
          end;
          Push(Wrap(Int64(A) + FHost.Random(Integer(Min(Int64(B) - A + 1, High(Integer))))));
        end;
      PcdThingcount: begin B := Pop; A := Pop; Push(FHost.ThingCount(A, B)); end;
      PcdThingcountdirect: begin A := M.ReadWord(I.PC); B := M.ReadWord(I.PC); Push(FHost.ThingCount(A, B)); end;
      PcdThingcountname: begin B := Pop; A := Pop; Push(FHost.ThingCountName(StringOf(A), B)); end;
      PcdTagwait, PcdTagwaitdirect:
        begin
          if Op = PcdTagwait then A := Pop else A := M.ReadWord(I.PC);
          I.State := asTagWait;
          I.StateData := A;
        end;
      { No polyobjects: their waits end at once. }
      PcdPolywait: Drop(1);
      PcdPolywaitdirect: M.ReadWord(I.PC);
      PcdScriptwait, PcdScriptwaitdirect:
        begin
          if Op = PcdScriptwait then A := Pop else A := M.ReadWord(I.PC);
          I.StateData := A;
          if Running(A) then I.State := asScriptWait else I.State := asScriptWaitPre;
        end;
      PcdChangefloor, PcdChangeceiling:
        begin
          B := Pop;
          A := Pop;
          FHost.ChangeFlat(A, StringOf(B), Op = PcdChangeceiling);
        end;
      PcdChangefloordirect, PcdChangeceilingdirect:
        begin
          A := M.ReadWord(I.PC);
          B := M.ReadWord(I.PC);
          FHost.ChangeFlat(A, StringOf(B), Op = PcdChangeceilingdirect);
        end;
      PcdLineside: Push(Ord(I.BackSide));
      PcdClearlinespecial: FHost.ClearLineSpecial(I.Line);
      PcdBeginprint: I.PrintText := '';
      PcdPrintstring: I.PrintText := I.PrintText + StringOf(Pop);
      PcdPrintlocalized: I.PrintText := I.PrintText + FHost.Localize(StringOf(Pop));
      PcdPrintnumber: I.PrintText := I.PrintText + IntToStr(Pop);
      PcdPrintcharacter: I.PrintText := I.PrintText + Chr(Pop and 255);
      PcdPrintfixed: I.PrintText := I.PrintText + FixedText(Pop);
      PcdPrintname: begin Drop(1); I.PrintText := I.PrintText + 'Player'; end;
      PcdPrintbinary: I.PrintText := I.PrintText + BinaryText(Cardinal(Pop));
      PcdPrinthex: I.PrintText := I.PrintText + IntToHex(Cardinal(Pop), 1);
      PcdPrintbind: begin Drop(1); I.PrintText := I.PrintText + '???'; end;
      PcdPrintmapchararray, PcdPrintworldchararray, PcdPrintglobalchararray:
        begin
          A := Pop;
          B := Pop;
          case Op of
            PcdPrintmapchararray: PrintArray(vkMapArray, A, B);
            PcdPrintworldchararray: PrintArray(vkWorldArray, A, B);
            else PrintArray(vkGlobalArray, A, B);
          end;
        end;
      PcdEndprint: Print(apPrint);
      PcdEndprintbold: Print(apBold);
      PcdEndlog: Print(apLog);
      PcdMorehudmessage: I.OptStart := -1;
      PcdOpthudmessage: I.OptStart := I.SP;
      PcdEndhudmessage, PcdEndhudmessagebold:
        begin
          if I.OptStart < 0 then I.OptStart := I.SP;
          I.SP := Max(I.LocalsBase, I.OptStart - 6);
          I.OptStart := -1;
          if Op = PcdEndhudmessagebold then Print(apBold) else Print(apHud);
        end;
      PcdSavestring:
        begin
          SetLength(FDynStrings, Length(FDynStrings) + 1);
          FDynStrings[High(FDynStrings)] := I.PrintText;
          I.PrintText := '';
          Push(AcsDynamicStringBase + High(FDynStrings));
        end;
      PcdStrlen: Push(Length(StringOf(Pop)));
      PcdTagstring: ;
      PcdPlayercount, PcdSingleplayer: Push(1);
      PcdGametype, PcdIsnetworkgame, PcdPlayerteam, PcdPlayerfrags, PcdPlayernumber, PcdBlueteamcount..PcdGetinvasionstate,
      PcdGetsigilpieces:
        Push(0);
      PcdGameskill: Push(FHost.GameSkill);
      PcdPlayerexpert: Push(Ord(FHost.GameSkill >= 3));
      PcdTimer: Push(FHost.LevelTime);
      PcdPlayerhealth: Push(FHost.PlayerHealth);
      PcdPlayerarmorpoints: Push(FHost.PlayerArmor);
      PcdPlayerblueskull..PcdPlayermastercard, PcdPlayerblackskull..PcdPlayersilvercard:
        Push(Ord(FHost.PlayerHasKey(Op - PcdPlayerblueskull)));
      PcdPlayeringame: begin A := Pop; Push(Ord(A = 0)); end;
      PcdPlayerisbot: begin Drop(1); Push(0); end;
      PcdActivatortid: Push(I.ActivatorTid);
      PcdSectorsound, PcdAmbientsound, PcdLocalambientsound, PcdActivatorsound:
        begin
          B := Pop;
          A := Pop;
          case Op of
            PcdSectorsound: FHost.PlaySound(I, StringOf(A), B, -1);
            PcdActivatorsound: FHost.PlaySound(I, StringOf(A), B, 0);
            else FHost.PlaySound(I, StringOf(A), B, -2);
          end;
        end;
      PcdThingsound:
        begin
          B := Pop;
          A := Pop;
          K := Pop;
          if K <> 0 then FHost.PlaySound(I, StringOf(A), B, K);
        end;
      PcdSoundsequence: Skip(1);
      PcdSetlinetexture:
        begin
          A := Pop;
          K := Pop;
          B := Pop;
          N := Pop;
          FHost.SetLineTexture(N, B, K, StringOf(A));
        end;
      PcdSetlineblocking: begin B := Pop; A := Pop; FHost.SetLineBlocking(A, B); end;
      PcdSetlinemonsterblocking: begin B := Pop; A := Pop; FHost.SetLineMonsterBlocking(A, B <> 0); end;
      PcdSetlinespecial:
        begin
          PopArgs(5);
          Special := Pop;
          A := Pop;
          FHost.SetLineSpecial(A, Special, Args);
        end;
      PcdMusicchange: begin Drop(1); FHost.SetMusic(StringOf(Pop)); end;
      PcdSetmusic, PcdLocalsetmusic: begin Drop(2); FHost.SetMusic(StringOf(Pop)); end;
      PcdSetmusicdirect, PcdLocalsetmusicdirect:
        begin
          A := M.ReadWord(I.PC);
          M.ReadWord(I.PC);
          M.ReadWord(I.PC);
          FHost.SetMusic(StringOf(A));
        end;
      PcdFixedmul: begin B := Pop; A := Pop; Push(Wrap((Int64(A) * B) div 65536)); end;
      PcdFixeddiv:
        begin
          B := Pop;
          A := Pop;
          if B = 0 then
          begin
            Stop(I, 'division by zero');
            Exit;
          end;
          Push(Wrap((Int64(A) * 65536) div B));
        end;
      PcdSin: Push(Round(Sin(Pop / 65536 * 2 * Pi) * 65536));
      PcdCos: Push(Round(Cos(Pop / 65536 * 2 * Pi) * 65536));
      PcdVectorangle:
        begin
          B := Pop;
          A := Pop;
          if (A = 0) and (B = 0) then Push(0)
          else Push(Round(ArcTan2(B, A) / (2 * Pi) * 65536) and $FFFF);
        end;
      PcdGetactorx, PcdGetactory, PcdGetactorz, PcdGetactorangle, PcdGetactorfloorz, PcdGetactorceilingz,
      PcdGetactorlightlevel:
        begin
          A := Pop;
          case Op of
            PcdGetactorx: K := 0;
            PcdGetactory: K := 1;
            PcdGetactorz: K := 2;
            PcdGetactorangle: K := 3;
            PcdGetactorfloorz: K := 4;
            PcdGetactorceilingz: K := 5;
            else K := 6;
          end;
          Push(FHost.ActorValue(I, A, K));
        end;
      PcdGetactorpitch: begin Drop(1); Push(0); end;
      PcdGetsectorfloorz, PcdGetsectorceilingz:
        begin
          Drop(2);
          A := Pop;
          Push(FHost.SectorValue(A, Ord(Op = PcdGetsectorceilingz)));
        end;
      PcdGetsectorlightlevel: Push(FHost.SectorValue(Pop, 2));
      PcdGetscreenwidth: Push(640);
      PcdGetscreenheight: Push(480);
      PcdSetresultvalue: I.ResultValue := Pop;
      PcdCall, PcdCalldiscard: CallFunction(M.ReadByte(I.PC), Op = PcdCalldiscard);
      PcdCallstack: CallFunction(Pop and $FFFF, false);
      PcdPushfunction: Push(M.ReadByte(I.PC));
      PcdReturnvoid: ReturnFrom(0);
      PcdReturnval: ReturnFrom(Pop);
      PcdGotostack: Jump(Pop);
      PcdCallfunc:
        begin
          N := M.ReadByte(I.PC);
          A := M.ReadShort(I.PC);
          LogOnce(SysUtils.Format('ACS function %d', [A]));
          Drop(N);
          Push(0);
        end;
      { Known, but nothing the game has: their arguments are dropped. }
      PcdSetgravity, PcdSetaircontrol, PcdSetstyle, PcdSetfont, PcdStarttranslation, PcdPlaymovie,
      PcdSetmugshotstate, PcdClearactorinventory:
        Skip(1);
      PcdSetgravitydirect, PcdSetaircontroldirect, PcdSetstyledirect, PcdSetfontdirect:
        begin
          M.ReadWord(I.PC);
          Skip(0);
        end;
      PcdClearinventory, PcdCancelfade, PcdEndtranslation: Skip(0);
      PcdGiveinventory, PcdTakeinventory, PcdSetactorangle, PcdSetactorpitch, PcdSetammocapacity,
      PcdSetmarineweapon, PcdSetmarinesprite, PcdGrabinput, PcdMovemousepointer, PcdChangesky:
        Skip(2);
      PcdGiveinventorydirect, PcdTakeinventorydirect:
        begin
          Inc(I.PC, 8);
          Skip(0);
        end;
      PcdCheckinventory, PcdCheckweapon, PcdSetweapon, PcdGetcvar, PcdGetammocapacity, PcdPlayerclass,
      PcdUseinventory, PcdClassifyactor, PcdCheckplayercamera, PcdGetlevelinfo:
        Skip(1, true);
      PcdCheckinventorydirect:
        begin
          M.ReadWord(I.PC);
          Skip(0, true);
        end;
      PcdGetactorproperty, PcdCheckactorinventory, PcdUseactorinventory, PcdCheckactorceilingtexture,
      PcdCheckactorfloortexture, PcdGetplayerinfo, PcdGetplayerinput, PcdUnmorphactor:
        Skip(2, true);
      PcdSetactorproperty, PcdSetcameratotexture, PcdSethudsize, PcdSetmousepointer, PcdConsolecommand,
      PcdReplacetextures, PcdGiveactorinventory, PcdTakeactorinventory:
        Skip(3);
      PcdSpawnspotfacing, PcdSetactorstate, PcdThingdamage2: Skip(3, true);
      PcdTranslationrange1: Skip(4);
      PcdSpawnspot: Skip(4, true);
      PcdSetactorposition: Skip(5, true);
      PcdFadeto, PcdSectordamage: Skip(5);
      PcdSpawn: Skip(6, true);
      PcdSpawnprojectile, PcdThingProjectile2, PcdSetthingspecial: Skip(7);
      PcdMorphactor: Skip(7, true);
      PcdTranslationrange2, PcdSetfloortrigger, PcdSetceilingtrigger: Skip(8);
      PcdFaderange: Skip(9);
      PcdConsolecommanddirect:
        begin
          Inc(I.PC, 12);
          Skip(0);
        end;
      PcdSpawndirect, PcdSpawnspotdirect:
        begin
          if Op = PcdSpawndirect then Inc(I.PC, 24) else Inc(I.PC, 16);
          Skip(0, true);
        end;
      PcdGetlinerowoffset: Push(0);
      PcdChangelevel:
        begin
          Drop(3);
          LevelName := StringOf(Pop);
          LogOnce('ChangeLevel (' + LevelName + ')');
        end;
      else
        begin
          Stop(I, SysUtils.Format('%s (p-code %d) not supported', [AcsPcodeName(Op), Op]));
          Exit;
        end;
    end;
  end;
end;

function TAcsVM.SaveState: TJSONObject;
var
  Arr, Sub, Fr: TJSONArray;
  J, K: Integer;
  X: TAcsInstance;
begin
  Result := TJSONObject.Create;
  Result.Add('mapVars', IntsToJson(FMapVars));
  Arr := TJSONArray.Create;
  for J := 0 to High(FMapArrays) do
    Arr.Add(IntsToJson(FMapArrays[J]));
  Result.Add('mapArrays', Arr);
  Arr := TJSONArray.Create;
  for J := 0 to High(FDynStrings) do Arr.Add(FDynStrings[J]);
  Result.Add('strings', Arr);
  Result.Add('started', FStarted);
  Arr := TJSONArray.Create;
  for J := 0 to FInstances.Count - 1 do
  begin
    X := Inst(J);
    if X.State = asDone then Continue;
    Sub := TJSONArray.Create;
    Sub.Add(X.Number);
    Sub.Add(X.PC);
    Sub.Add(Ord(X.State));
    Sub.Add(X.StateData);
    Sub.Add(X.LocalsBase);
    Sub.Add(Ord(X.Activator));
    Sub.Add(X.Line);
    Sub.Add(X.BackSide);
    Sub.Add(X.PrintText);
    Sub.Add(X.OptStart);
    Sub.Add(X.ResultValue);
    Sub.Add(X.ActivatorTid);
    Fr := TJSONArray.Create;
    for K := 0 to X.SP - 1 do Fr.Add(X.Stack[K]);
    Sub.Add(Fr);
    Fr := TJSONArray.Create;
    for K := 0 to High(X.Frames) do
    begin
      Fr.Add(X.Frames[K].ReturnPC);
      Fr.Add(X.Frames[K].LocalsBase);
      Fr.Add(X.Frames[K].Discard);
    end;
    Sub.Add(Fr);
    Arr.Add(Sub);
  end;
  Result.Add('scripts', Arr);
end;

procedure TAcsVM.LoadState(const J: TJSONObject);
var
  Arr, Sub, Fr: TJSONArray;
  K, L, S: Integer;
  X: TAcsInstance;
  D: TJSONData;
begin
  if J = nil then Exit;
  IntsFromJson(J.Find('mapVars'), FMapVars);
  D := J.Find('mapArrays');
  if D is TJSONArray then
    for K := 0 to Min(High(FMapArrays), TJSONArray(D).Count - 1) do
      IntsFromJson(TJSONArray(D).Items[K], FMapArrays[K]);
  D := J.Find('strings');
  SetLength(FDynStrings, 0);
  if D is TJSONArray then
  begin
    SetLength(FDynStrings, TJSONArray(D).Count);
    for K := 0 to High(FDynStrings) do FDynStrings[K] := TJSONArray(D).Strings[K];
  end;
  FStarted := J.Get('started', 0);
  FInstances.Clear;
  D := J.Find('scripts');
  if not (D is TJSONArray) then Exit;
  Arr := TJSONArray(D);
  for K := 0 to Arr.Count - 1 do
  begin
    if not (Arr.Items[K] is TJSONArray) then Continue;
    Sub := TJSONArray(Arr.Items[K]);
    if Sub.Count < 14 then Continue;
    S := FModule.FindScript(Sub.Integers[0]);
    if S < 0 then Continue;
    X := TAcsInstance.Create;
    X.Script := S;
    X.Number := Sub.Integers[0];
    X.PC := Sub.Integers[1];
    X.State := TAcsState(EnsureRange(Sub.Integers[2], 0, Ord(High(TAcsState))));
    X.StateData := Sub.Integers[3];
    X.LocalsBase := Sub.Integers[4];
    X.Activator := TAcsActivator(EnsureRange(Sub.Integers[5], 0, Ord(High(TAcsActivator))));
    X.Line := Sub.Integers[6];
    X.BackSide := Sub.Booleans[7];
    X.PrintText := Sub.Strings[8];
    X.OptStart := Sub.Integers[9];
    X.ResultValue := Sub.Integers[10];
    X.ActivatorTid := Sub.Integers[11];
    if Sub.Items[12] is TJSONArray then
    begin
      Fr := TJSONArray(Sub.Items[12]);
      X.SP := Fr.Count;
      SetLength(X.Stack, Max(64, Fr.Count * 2));
      for L := 0 to High(X.Stack) do X.Stack[L] := 0;
      for L := 0 to Fr.Count - 1 do X.Stack[L] := Fr.Integers[L];
    end;
    if Sub.Items[13] is TJSONArray then
    begin
      Fr := TJSONArray(Sub.Items[13]);
      SetLength(X.Frames, Fr.Count div 3);
      for L := 0 to High(X.Frames) do
      begin
        X.Frames[L].ReturnPC := Fr.Integers[L * 3];
        X.Frames[L].LocalsBase := Fr.Integers[L * 3 + 1];
        X.Frames[L].Discard := Fr.Booleans[L * 3 + 2];
      end;
    end;
    X.LocalsBase := EnsureRange(X.LocalsBase, 0, X.SP);
    FInstances.Add(X);
  end;
end;

end.
