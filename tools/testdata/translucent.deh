Patch File for DeHackEd v3.0
# MBF's TRANSLUCENT bit (31) on the imp, by name; the zombieman's by
# number (bit 31 written unsigned, plus SOLID, SHOOTABLE and COUNTKILL)
Doom version = 21
Patch format = 6

Thing 12 (Imp)
Bits = SOLID+SHOOTABLE+COUNTKILL+TRANSLUCENT

Thing 2 (Zombieman)
Bits = 2151677958
