<?xml version="1.0" encoding="utf-8"?>
<!--
  Castle DOOM: Doom WAD levels rendered and played with Castle Game Engine.
  See https://castle-engine.io/project_manifest for documentation of this file.
-->
<project name="castle-doom"
  game_units="GameInitialize"
  qualified_name="io.castleengine.castledoom"
  caption="Castle DOOM"
  author="castle-doom"
  screen_orientation="landscape"
  editor_units="DoomHud;DoomFont;DoomMenu;DoomAutomap;DoomIntermission;DoomFinale;DoomWipe;DoomWorldStatus;DoomMapTransform;GameTouch"
>
  <version value="0.44.0" code="48" />
  <!-- The sounds come from the WAD, so the build tool cannot see from the
       data that sound is used (Android's "sound" service, OpenAL). -->
  <!-- The launcher icon (Android, the Linux desktop file, macOS). -->
  <icons>
    <icon path="pages/icon-512.png" />
  </icons>
  <dependencies>
    <dependency name="Sound" />
  </dependencies>
  <compiler_options>
    <search_paths>
      <path value="code/" />
    </search_paths>
  </compiler_options>
</project>
